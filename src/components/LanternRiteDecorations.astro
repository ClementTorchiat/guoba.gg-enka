---
// src/components/LanternRiteDecorations.astro
// Composant temporaire pour le Festival des Lanternes (Nouvel An Chinois).

const lanterns = Array.from({ length: 25 });
---

<div id="lanternrite-decorations" aria-hidden="true">
    <div class="lanterns-container">
        {lanterns.map((_, i) => (
            <div class="lantern" style={`
                left: ${Math.random() * 100}%;
                animation-duration: ${Math.random() * 5 + 8}s;
                animation-delay: ${Math.random() * 5}s;
                transform: scale(${Math.random() * 0.5 + 0.5});
            `}>
                <div class="lantern-body"></div>
            </div>
        ))}
    </div>
    <div class="lanternrite-glow"></div>
</div>

<template id="lanternrite-knots-template">
    <div class="chinese-knots-container" aria-hidden="true">
        <div class="knot knot-left">
            <svg viewBox="0 0 40 80" width="30" height="60" style="overflow: visible;" xmlns="http://www.w3.org/2000/svg">
                <line x1="20" y1="0" x2="20" y2="10" stroke="#d84315" stroke-width="2"/>
                <path d="M 20,10 L 30,20 L 20,30 L 10,20 Z" fill="#d84315"/>
                <path d="M 20,30 L 35,45 L 20,60 L 5,45 Z" fill="#d84315"/>
                <line x1="20" y1="60" x2="20" y2="80" stroke="#d84315" stroke-width="2"/>
                <!-- Tassel details -->
                <line x1="16" y1="65" x2="16" y2="80" stroke="#d84315" stroke-width="1"/>
                <line x1="24" y1="65" x2="24" y2="80" stroke="#d84315" stroke-width="1"/>
            </svg>
        </div>
        <div class="knot knot-right">
            <svg viewBox="0 0 40 80" width="30" height="60" style="overflow: visible;" xmlns="http://www.w3.org/2000/svg">
                <line x1="20" y1="0" x2="20" y2="10" stroke="#d84315" stroke-width="2"/>
                <path d="M 20,10 L 30,20 L 20,30 L 10,20 Z" fill="#d84315"/>
                <path d="M 20,30 L 35,45 L 20,60 L 5,45 Z" fill="#d84315"/>
                <line x1="20" y1="60" x2="20" y2="80" stroke="#d84315" stroke-width="2"/>
                <!-- Tassel details -->
                <line x1="16" y1="65" x2="16" y2="80" stroke="#d84315" stroke-width="1"/>
                <line x1="24" y1="65" x2="24" y2="80" stroke="#d84315" stroke-width="1"/>
            </svg>
        </div>
    </div>
</template>

<template id="lanternrite-logo-template">
    <div class="lanternrite-logo-icon">
        <svg viewBox="0 0 32 32" width="24" height="24" style="overflow: visible;" xmlns="http://www.w3.org/2000/svg">
            <rect x="8" y="6" width="16" height="20" rx="2" fill="#ffb300" stroke="#d84315" stroke-width="2"/>
            <path d="M12,2 L20,2 L20,6 L12,6 Z" fill="#d84315" />
            <path d="M12,26 L20,26 L20,30 L12,30 Z" fill="#d84315" />
            <!-- Tassel -->
            <path d="M16,30 L16,40 M14,30 L14,38 M18,30 L18,38" stroke="#d84315" stroke-width="1.5" />
        </svg>
    </div>
</template>

<style>
    #lanternrite-decorations {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        pointer-events: none;
        z-index: 9999;
        overflow: hidden;
    }

    .lanterns-container {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
    }

    .lantern {
        position: absolute;
        bottom: -50px;
        width: 20px;
        height: 25px;
        animation: float-up linear infinite;
        opacity: 0.9;
        filter: drop-shadow(0 0 10px rgba(255, 179, 0, 0.8));
    }

    .lantern-body {
        width: 100%;
        height: 100%;
        background: #ffca28;
        border-radius: 4px;
        position: relative;
        border-top: 3px solid #d84315;
        border-bottom: 3px solid #d84315;
    }

    @keyframes float-up {
        0% { transform: translateY(50px) rotate(0deg); opacity: 0; }
        10% { opacity: 1; }
        90% { opacity: 1; }
        100% { transform: translateY(-110vh) rotate(15deg); opacity: 0; }
    }

    .lanternrite-glow {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 150px;
        background: linear-gradient(to bottom, rgba(255, 179, 0, 0.15) 0%, transparent 100%);
        pointer-events: none;
        z-index: 1;
    }

    :global(.chinese-knots-container) {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 0;
        pointer-events: none;
        z-index: 50;
    }
    
    :global(.knot) {
        position: absolute;
        top: -10px;
        filter: drop-shadow(0 2px 5px rgba(0,0,0,0.3));
        animation: sway-knot 4s ease-in-out infinite alternate;
        transform-origin: top center;
    }

    :global(.knot-left) {
        left: 20px;
    }

    :global(.knot-right) {
        right: 20px;
        animation-delay: -2s;
    }

    @keyframes sway-knot {
        0% { transform: rotate(-5deg); }
        100% { transform: rotate(5deg); }
    }

    :global(.lanternrite-logo-icon) {
        position: absolute;
        bottom: -2px;
        right: -8px;
        transform: rotate(15deg);
        pointer-events: none;
        z-index: 10;
        filter: drop-shadow(0 2px 4px rgba(0,0,0,0.3));
    }
</style>

<script>
    (function () {
        const logoContainer = document.querySelector(".sidebar-title-container") as HTMLElement | null;
        if (logoContainer) {
            logoContainer.style.position = "relative";
            const iconTemplate = document.getElementById("lanternrite-logo-template") as HTMLTemplateElement | null;
            if (iconTemplate) {
                logoContainer.appendChild(iconTemplate.content.cloneNode(true));
            }
        }

        const mainContent = document.querySelector(".main-content") as HTMLElement | null;
        if (mainContent) {
            mainContent.style.position = "relative";
            const knotsTemplate = document.getElementById("lanternrite-knots-template") as HTMLTemplateElement | null;
            if (knotsTemplate) {
                mainContent.appendChild(knotsTemplate.content.cloneNode(true));
            }
        }

        const observer = new MutationObserver(() => {
            const profile = document.getElementById("player-profile");
            const decorations = document.getElementById("lanternrite-decorations");
            const icon = document.querySelector(".lanternrite-logo-icon") as HTMLElement | null;
            const knots = document.querySelector(".chinese-knots-container") as HTMLElement | null;

            if (profile) {
                const isProfileActive = profile.innerHTML.trim().length > 0;
                if (decorations) decorations.style.display = isProfileActive ? "none" : "block";
                if (icon) icon.style.display = isProfileActive ? "none" : "block";
                if (knots) knots.style.display = isProfileActive ? "none" : "block";
            }
        });

        observer.observe(document.body, { childList: true, subtree: true });
    })();
</script>
