---
// src/components/EasterDecorations.astro
// Composant temporaire pour Pâques.

const eggs = Array.from({ length: 30 });
const colors = ["#ff8a80", "#ffd180", "#ccff90", "#84ffff", "#b388ff", "#ff80ab"];
---

<div id="easter-decorations" aria-hidden="true">
    <div class="eggs-container">
        {
            eggs.map((_, i) => (
                <div
                    class="egg-wrapper"
                    style={`
                left: ${Math.random() * 100}%;
                animation-duration: ${Math.random() * 5 + 6}s;
                animation-delay: ${Math.random() * 5}s;
                transform: scale(${Math.random() * 0.4 + 0.6});
            `}
                >
                    <svg viewBox="0 0 32 40" width="20" height="25" xmlns="http://www.w3.org/2000/svg">
                        <ellipse cx="16" cy="20" rx="14" ry="19" fill={colors[i % colors.length]} />
                        <path d="M 2 20 Q 8 15 16 20 T 30 20" stroke="rgba(255,255,255,0.5)" stroke-width="3" fill="none" />
                        <path d="M 4 10 Q 10 5 16 10 T 28 10" stroke="rgba(255,255,255,0.5)" stroke-width="2" fill="none" />
                        <path d="M 4 30 Q 10 25 16 30 T 28 30" stroke="rgba(255,255,255,0.5)" stroke-width="2" fill="none" />
                    </svg>
                </div>
            ))
        }
    </div>
</div>

<template id="easter-logo-template">
    <div class="easter-bunny-ears">
        <svg viewBox="0 0 32 32" width="36" height="36" style="overflow: visible;" xmlns="http://www.w3.org/2000/svg">
            <path d="M 10,12 C 6,-5 14,-10 16,5 C 18,-10 26,-5 22,12" fill="var(--text-always-white)" stroke="#e0e0e0" stroke-width="1"></path>
            <path d="M 11,10 C 9,-2 13,-6 15,4 C 17,-6 21,-2 19,10" fill="#ff80ab"></path>
        </svg>
    </div>
</template>

<style>
    #easter-decorations {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        pointer-events: none;
        z-index: 9999;
        overflow: hidden;
    }

    .eggs-container {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
    }

    .egg-wrapper {
        position: absolute;
        top: -40px;
        animation: fall-egg linear infinite;
        opacity: 0.85;
    }

    @keyframes fall-egg {
        0% {
            transform: translateY(-40px) rotate(-15deg);
        }
        50% {
            transform: translateY(50vh) rotate(15deg);
        }
        100% {
            transform: translateY(105vh) rotate(-15deg);
        }
    }

    :global(.easter-bunny-ears) {
        position: absolute;
        top: -2px;
        left: -2px;
        pointer-events: none;
        z-index: 10;
        filter: drop-shadow(0 2px 4px var(--shadow-subtle));
    }
</style>

<script>
    document.addEventListener("astro:page-load", () => {
        const logoContainer = document.querySelector(".sidebar-title-container") as HTMLElement | null;
        if (logoContainer && !document.querySelector(".easter-bunny-ears")) {
            logoContainer.style.position = "relative";
            const iconTemplate = document.getElementById("easter-logo-template") as HTMLTemplateElement | null;
            if (iconTemplate) {
                logoContainer.appendChild(iconTemplate.content.cloneNode(true));
            }
        }

        function updateVisibility() {
            const profile = document.getElementById("player-profile");
            const decorations = document.getElementById("easter-decorations");
            const icon = document.querySelector(".easter-bunny-ears") as HTMLElement | null;
            const homeTitle = document.getElementById("home-title");

            if (homeTitle && !document.getElementById("easter-home-text")) {
                const span = document.createElement("span");
                span.id = "easter-home-text";
                span.textContent = (window as any).t ? (window as any)("home.event.easter") : "Joyeuses Pâques !";
                span.style.fontSize = "14px";
                span.style.color = "var(--text-grey)";
                span.style.fontWeight = "normal";
                span.style.marginLeft = "8px";
                span.style.fontFamily = "ShinShin, sans-serif";
                homeTitle.appendChild(span);
            }

            const textNode = document.getElementById("easter-home-text");

            if (profile) {
                const isProfileActive = profile.innerHTML.trim().length > 0;
                if (decorations) decorations.style.display = isProfileActive ? "none" : "block";
                if (icon) icon.style.display = isProfileActive ? "none" : "block";
                if (textNode) textNode.style.display = isProfileActive ? "none" : "block";
            }
        }

        updateVisibility();

        const observer = new MutationObserver(updateVisibility);
        if (document.body) observer.observe(document.body, { childList: true, subtree: true });
    });
</script>
