                                if (badges) {
                                    statsHtml = `<div style="display:flex; flex-wrap:wrap; gap:4px; margin-top:3px;">${badges}</div>`;
                                }
                            }
                            return `
                                <div style="margin-bottom:6px; font-size:11px; line-height:1.35;">
