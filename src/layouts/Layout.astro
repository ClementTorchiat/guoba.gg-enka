---
// src/layouts/Layout.astro
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = "guoba.gg - Simulateur Genshin Impact" } = Astro.props;
---

<!DOCTYPE html>
<html lang="fr" data-theme="wish">
<head>
    <meta charset="UTF-8">
    <script is:inline>
        (function () {
            const W = window.screen.width;
            if      (W >= 3840) document.documentElement.style.zoom = "1.5";
            else if (W >= 2560) document.documentElement.style.zoom = "1.25";
        })();
    </script>
    <script is:inline>
        (function() {
            const savedTheme = localStorage.getItem('guoba_theme') || 'wish';
            document.documentElement.setAttribute('data-theme', savedTheme);
        })();
    </script>
    <title>{title}</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="icon" type="image/png" href="/assets/global/favicon.png">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="tdm-reservation" content="1">
    <meta property="og:locale" content="fr_FR">
    <meta name="robots" content="noindex, nofollow">
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/dom-to-image-more/2.9.5/dom-to-image-more.min.js"></script>

    <meta name="description" content="guoba.gg est un outil d'analyse de builds et de statistiques pour Genshin Impact. Évaluez vos artéfacts, optimisez vos personnages et générez des vitrines à partir de votre UID.">
    <meta name="keywords" content="Genshin Impact, build, simulateur, artéfacts, enka network, UID, statistiques, optimisation">
    <meta name="author" content="clem">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://guoba.clement-torchiat.fr/">
    <meta property="og:title" content="guoba.gg - Simulateur Genshin Impact">
    <meta property="og:description" content="guoba.gg est un outil d'analyse de builds et de statistiques pour Genshin Impact. Évaluez vos artéfacts, optimisez vos personnages et générez des vitrines à partir de votre UID.">
    <meta property="og:image" content="https://guoba.clement-torchiat.fr/assets/global/banner.png">
    <meta property="og:site_name" content="guoba.gg">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="guoba.gg - Simulateur Genshin Impact">
    <meta name="twitter:description" content="guoba.gg est un outil d'analyse de builds et de statistiques pour Genshin Impact. Évaluez vos artéfacts, optimisez vos personnages et générez des vitrines à partir de votre UID.">
    <meta name="twitter:image" content="https://guoba.clement-torchiat.fr/assets/global/banner.png">
    <meta name="theme-color" content="#1e2024">

    <link rel="apple-touch-icon" href="/assets/global/favicon.png">
</head>
<body>
    <slot />
</body>
</html>
