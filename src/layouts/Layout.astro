                                </button>

                                <div id="sidebar-display-custom-menu" class="custom-select-menu" style="width: 150px;">
                                    <div class="custom-select-item" data-value="score_grade" onclick="selectCustomSidebarDisplay(event, 'score_grade', 'account.settings.sidebarDisplay.score')">
                                        <span data-i18n="account.settings.sidebarDisplay.score">Score et Grade</span>
                                    </div>
                                    <div class="custom-select-item" data-value="top_percent" onclick="selectCustomSidebarDisplay(event, 'top_percent', 'account.settings.sidebarDisplay.top')">
                                        <span data-i18n="account.settings.sidebarDisplay.top">Top X%</span>
                                    </div>
                                    <div class="custom-select-item" data-value="both" onclick="selectCustomSidebarDisplay(event, 'both', 'account.settings.sidebarDisplay.both')">
                                        <span data-i18n="account.settings.sidebarDisplay.both">Les deux</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div style="display: flex; align-items: center; justify-content: space-between; color: var(--text-primary); font-size: 14px;">
                            <span data-i18n="account.settings.rankingDecimals">Précision des classements</span>
                            <div class="custom-select-container">
                                <button onclick="toggleRankingDecimalsMenu(event)" class="link-button hover-bg-hover" style="width: 150px; justify-content: space-between; border: none; background: var(--shadow-subtle); color: var(--text-primary); padding: 6px 12px; border-radius: 6px; cursor: pointer; font-family: inherit; font-size: 13px; font-weight: normal; outline: none; display: flex; align-items: center; transition: background-color 0.2s ease;">
                                    <span id="active-ranking-decimals-text" data-i18n="account.settings.decimals1" style="white-space: nowrap;">1 décimale</span>
                                    <img src="/assets/simulator/icons/icon_arrow_down_white.svg" alt="" class="sort-arrow" style="font-size: 12px; opacity: 0.6; margin-left: 8px;" />
                                </button>

                                <div id="ranking-decimals-custom-menu" class="custom-select-menu" style="width: 150px;">
                                    <div class="custom-select-item" data-value="0" onclick="selectCustomRankingDecimals(event, '0', 'account.settings.decimals0')">
                                        <span data-i18n="account.settings.decimals0">0 décimale</span>
                                    </div>
                                    <div class="custom-select-item" data-value="1" onclick="selectCustomRankingDecimals(event, '1', 'account.settings.decimals1')">
                                        <span data-i18n="account.settings.decimals1">1 décimale</span>
                                    </div>
                                    <div class="custom-select-item" data-value="2" onclick="selectCustomRankingDecimals(event, '2', 'account.settings.decimals2')">
                                        <span data-i18n="account.settings.decimals2">2 décimales</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <button onclick="logoutUser()" class="button-logout" data-i18n="account.settings.logout">Se déconnecter</button>
            </div>
        </div>
    </body>
</html>
