---
// src/layouts/Layout.astro
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

interface Props {
    title?: string;
    titleKey?: string;
    description?: string;
    schema?: Record<string, any> | Array<Record<string, any>>;
}

const { title = "guoba.gg - Simulateur Genshin Impact", titleKey, description = "guoba.gg est un outil d'analyse de builds et de statistiques pour Genshin Impact. Évaluez vos artéfacts, optimisez vos personnages et générez des vitrines à partir de votre UID.", schema } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://guoba.clement-torchiat.fr").href;

const defaultSchema = {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "guoba.gg",
    url: "https://guoba.clement-torchiat.fr/",
    description: description,
    applicationCategory: "GameApplication",
    operatingSystem: "All",
    inLanguage: "fr",
    author: {
        "@type": "Person",
        name: "Clem",
    },
    offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "EUR",
    },
};

const finalSchema = schema || defaultSchema;
---

<!doctype html>
<html lang="fr" data-theme="wish">
    <head>
        <meta charset="UTF-8" />
        <ClientRouter />
        <script is:inline>
            (function initThemeLangAndZoom() {
                function apply() {
                    const W = window.screen.width;
                    if (W >= 3840) document.documentElement.style.zoom = "1.5";
                    else if (W >= 2560) document.documentElement.style.zoom = "1.25";
                    const savedTheme = localStorage.getItem("guoba_theme") || "wish";
                    document.documentElement.setAttribute("data-theme", savedTheme);

                    const storedLang = localStorage.getItem("guoba_lang");
                    const browserLang = navigator.language ? navigator.language.slice(0, 2) : "fr";
                    const lang = ["fr", "en"].includes(storedLang) ? storedLang : ["fr", "en"].includes(browserLang) ? browserLang : "fr";
                    document.documentElement.lang = lang;

                    const reduceTransp = localStorage.getItem("guoba_reduce_transparency") === "true";
                    if (reduceTransp) document.documentElement.classList.add("reduce-transparency");
                    else document.documentElement.classList.remove("reduce-transparency");
                }
                apply();
                document.addEventListener("astro:after-swap", apply);
            })();
        </script>
        <title data-i18n-title-tag={titleKey}>{title}</title>

        <!-- Balise canonique dynamique -->
        <link rel="canonical" href={canonicalURL} />

        <!-- Données structurées Schema.org JSON-LD -->
        <script type="application/ld+json" set:html={JSON.stringify(finalSchema)} />

        <!-- Preconnect & DNS-prefetch pour les connexions critiques -->
        <link rel="preconnect" href="https://enka.network" crossorigin />
        <link rel="dns-prefetch" href="https://enka.network" />

        <link rel="icon" type="image/png" href="/assets/global/favicon.png" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="tdm-reservation" content="1" />
        <meta property="og:locale" content="fr_FR" />
        <meta name="robots" content="noindex, nofollow" />

        <meta name="description" content={description} />
        <meta name="keywords" content="Genshin Impact, build, simulateur, artéfacts, enka network, UID, statistiques, optimisation" />
        <meta name="author" content="clem" />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content="https://guoba.clement-torchiat.fr/assets/global/banner.png" />
        <meta property="og:site_name" content="guoba.gg" />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content="https://guoba.clement-torchiat.fr/assets/global/banner.png" />
        <meta name="theme-color" content="#1e2024" />

        <link rel="apple-touch-icon" href="/assets/global/favicon.png" />

        <script is:inline>
            window.toggleSidebarCollapse = function () {
                const sidebar = document.querySelector(".sidebar");
                const icon = document.getElementById("sidebar-collapse-icon");
                if (sidebar && sidebar.classList.contains("sidebar-collapsed")) {
                    sidebar.classList.remove("sidebar-collapsed");
                    if (icon) icon.style.transform = "rotate(90deg)";
                    localStorage.setItem("sidebarCollapsed", "false");
                } else if (sidebar) {
                    sidebar.classList.add("sidebar-collapsed");
                    if (icon) icon.style.transform = "rotate(-90deg)";
                    localStorage.setItem("sidebarCollapsed", "true");
                }
            };

            function restoreSidebarState() {
                const sidebar = document.querySelector(".sidebar");
                if (!sidebar) return;
                const isCollapsed = localStorage.getItem("sidebarCollapsed") === "true";
                const icon = document.getElementById("sidebar-collapse-icon");
                if (isCollapsed) {
                    sidebar.classList.add("sidebar-collapsed");
                    if (icon) icon.style.transform = "rotate(-90deg)";
                } else {
                    sidebar.classList.remove("sidebar-collapsed");
                    if (icon) icon.style.transform = "rotate(90deg)";
                }

                if (window.location.pathname !== "/") {
                    const wrapper = document.getElementById("user-account-wrapper");
                    if (wrapper) wrapper.style.display = "";
                }
            }

            function restoreGlobalSettings() {
                if (localStorage.getItem("guoba_reduce_transparency") === "true") {
                    document.documentElement.classList.add("reduce-transparency");
                } else {
                    document.documentElement.classList.remove("reduce-transparency");
                }
            }

            document.addEventListener("astro:page-load", () => {
                restoreSidebarState();
                restoreGlobalSettings();
            });
            document.addEventListener("astro:after-swap", () => {
                restoreSidebarState();
                restoreGlobalSettings();
            });

            restoreGlobalSettings(); // Apply immediately
        </script>
        <script>
            import "../scripts/auth.js";
        </script>
    </head>
    <body>
        <slot />
        <div id="global-tooltip"></div>
        <div id="combat-stat-tooltip"></div>
        <div id="artifact-stat-tooltip"></div>
        <div id="base-stat-tooltip"></div>
        <div id="teammate-tooltip"></div>
        <div id="login-modal-overlay" style="display: none; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0, 0, 0, 0.6); z-index: 9999; align-items: center; justify-content: center; backdrop-filter: blur(4px);">
            <div id="login-modal" style="background: var(--bg-panel); border-radius: 8px; padding: 24px; width: 90%; max-width: 440px; position: relative; display: flex; flex-direction: column; gap: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.5);">
                <button class="modal-close-btn" onclick="closeLoginModal()" style="position: absolute; top: 12px; right: 12px; background: none; border: none; cursor: pointer; width: 40px; height: 40px; border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
                <div style="text-align: center; margin-top: 10px;">
                    <h3 style="margin: 0 0 8px 0; color: var(--text-primary); font-size: 20px; font-weight: normal; text-align: left;" data-i18n="account.login.title">Créer un compte</h3>
                    <p style="margin: 0; color: var(--text-muted); font-size: 14px; text-align: left;" data-i18n="account.login.desc">Connectez-vous pour débloquer plus de fonctionnalités</p>
                </div>

                <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 12px; color: var(--text-primary); font-size: 14px; background: var(--bg-body); padding: 15px; border-radius: 8px;">
                    <li style="display: flex; align-items: center; gap: 10px;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#4ade80" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        <span data-i18n="account.login.feature1">Revendiquer la propriété d'un UID</span>
                    </li>
                    <li style="display: flex; align-items: center; gap: 10px;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#4ade80" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        <span data-i18n="account.login.feature2">Se retirer des classements</span>
                    </li>
                    <li style="display: flex; align-items: center; gap: 10px;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#4ade80" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        <span data-i18n="account.login.feature3">Sauvegarder vos préférences d'affichage</span>
                    </li>
                    <li style="display: flex; align-items: center; gap: 10px;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#4ade80" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        <span data-i18n="account.login.feature4">Comparer vos builds en détail avec les autres</span>
                    </li>
                </ul>

                <button style="background: #5865F2; color: var(--text-always-white); border: none; border-radius: 8px; padding: 12px; font-weight: bold; font-size: 16px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 10px; transition: background 0.2s;" onmouseover="this.style.background='#4752C4'" onmouseout="this.style.background='#5865F2'" onclick="loginWithDiscord()">
                    <svg width="24" height="24" viewBox="0 0 127.14 96.36" fill="var(--text-always-white)" xmlns="http://www.w3.org/2000/svg">
                        <path d="M107.7,8.07A105.15,105.15,0,0,0,81.47,0a72.06,72.06,0,0,0-3.36,6.83A97.68,97.68,0,0,0,49,6.83,72.37,72.37,0,0,0,45.64,0,105.89,105.89,0,0,0,19.39,8.09C2.79,32.65-1.71,56.6.54,80.21h0A105.73,105.73,0,0,0,32.71,96.36,77.7,77.7,0,0,0,39.6,85.25a68.42,68.42,0,0,1-10.85-5.18c.91-.66,1.8-1.34,2.66-2a75.57,75.57,0,0,0,64.32,0c.87.71,1.76,1.39,2.66,2a68.68,68.68,0,0,1-10.87,5.19,77,77,0,0,0,6.89,11.1A105.25,105.25,0,0,0,126.6,80.22h0C129.24,52.84,122.09,29.11,107.7,8.07ZM42.45,65.69C36.18,65.69,31,60,31,53s5-12.74,11.43-12.74S54,46,53.89,53,48.84,65.69,42.45,65.69Zm42.24,0C78.41,65.69,73.31,60,73.31,53s5-12.74,11.43-12.74S96.2,46,96.12,53,91.08,65.69,84.69,65.69Z"></path>
                    </svg>
                    <span data-i18n="account.login.button">Se connecter avec Discord</span>
                </button>
            </div>
        </div>

        <script is:inline>
            function copyVerificationCode(btn) {
                const display = document.getElementById('verification-code-display');
                if (!display) return;
                navigator.clipboard.writeText(display.textContent).then(() => {
                    const originalSvg = btn.innerHTML;
                    btn.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#4ade80" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>';
                    setTimeout(() => {
                        btn.innerHTML = originalSvg;
                    }, 2000);
                }).catch(err => {
                    console.error('Erreur lors de la copie du code:', err);
                });
            }

            function openLoginModal() {
                const modal = document.getElementById("login-modal-overlay");
                if (modal) {
                    modal.style.display = "flex";
                    modal.style.opacity = "0";
                    setTimeout(() => {
                        modal.style.transition = "opacity 0.2s";
                        modal.style.opacity = "1";
                    }, 10);
                }
            }

            function closeLoginModal() {
                const modal = document.getElementById("login-modal-overlay");
                if (modal) {
                    modal.style.opacity = "0";
                    setTimeout(() => {
                        modal.style.display = "none";
                    }, 200);
                }
            }

            function toggleReduceTransparency(checked) {
                localStorage.setItem("guoba_reduce_transparency", checked);
                if (checked) {
                    document.documentElement.classList.add("reduce-transparency");
                } else {
                    document.documentElement.classList.remove("reduce-transparency");
                }
            }

            if (typeof window !== "undefined" && !window.showGlobalTooltip) {
                window.showGlobalTooltip = function (element, text, color = "rgba(255,255,255,0.4)") {
                    const tooltip = document.getElementById("global-tooltip");
                    if (!tooltip || !element) return;
                    tooltip.innerHTML = text;
                    tooltip.style.setProperty("--tooltip-color", color || "var(--accent-gold)");

                    tooltip.classList.remove("placement-top", "placement-bottom");

                    const rect = element.getBoundingClientRect();
                    const tWidth = tooltip.offsetWidth || 180;
                    const tHeight = tooltip.offsetHeight || 34;
                    const gap = 8;
                    const padding = 12;

                    const spaceBelow = window.innerHeight - rect.bottom;
                    const placeTop = spaceBelow < (tHeight + gap + 10) && rect.top > (tHeight + gap);

                    const top = placeTop ? (rect.top - tHeight - gap) : (rect.bottom + gap);
                    tooltip.classList.add(placeTop ? "placement-top" : "placement-bottom");

                    const elemCenterX = rect.left + rect.width / 2;
                    let left = elemCenterX;
                    const halfWidth = tWidth / 2;

                    if (left - halfWidth < padding) {
                        left = padding + halfWidth;
                    } else if (left + halfWidth > window.innerWidth - padding) {
                        left = window.innerWidth - padding - halfWidth;
                    }

                    const arrowX = Math.max(12, Math.min(tWidth - 12, elemCenterX - (left - halfWidth)));
                    tooltip.style.setProperty("--arrow-left", arrowX + "px");

                    tooltip.style.left = left + "px";
                    tooltip.style.top = top + "px";
                    tooltip.style.visibility = "visible";
                    tooltip.style.opacity = "1";
                    tooltip.style.transform = "translate(-50%, 0)";
                };
            }
            if (typeof window !== "undefined" && !window.hideGlobalTooltip) {
                window.hideGlobalTooltip = function () {
                    const tooltip = document.getElementById("global-tooltip");
                    if (tooltip) {
                        const isTop = tooltip.classList.contains("placement-top");
                        tooltip.style.visibility = "hidden";
                        tooltip.style.opacity = "0";
                        tooltip.style.transform = isTop ? "translate(-50%, -4px)" : "translate(-50%, 4px)";
                    }
                };
            }

            if (typeof window !== "undefined") {
                const ELEMENT_COLORS_MAP = {
                    pyro: '#ef7a35', hydro: '#4bc3f7', dendro: '#a5c83b', electro: '#b07ce8',
                    anemo: '#74c2a8', cryo: '#98c8d8', geo: '#e2b34a'
                };

                function formatBuffStatBadge(statKey, val) {
                    const isFr = (window.GUOBA_LANG !== 'en');
                    const STAT_SHORT = {
                        atk: isFr ? 'ATQ' : 'ATK', atk_: isFr ? 'ATQ' : 'ATK',
                        hp: isFr ? 'PV' : 'HP', hp_: isFr ? 'PV' : 'HP',
                        def: isFr ? 'DÉF' : 'DEF', def_: isFr ? 'DÉF' : 'DEF',
                        eleMas: isFr ? 'ME' : 'EM', enerRech_: isFr ? 'RE' : 'ER',
                        critRate_: isFr ? 'TC' : 'CR', critDMG_: isFr ? 'DC' : 'CD',
                        elemental_dmg_: isFr ? 'DGT Élém.' : 'Elem. DMG',
                        pyro_dmg_: isFr ? 'DGT Pyro' : 'Pyro DMG',
                        hydro_dmg_: isFr ? 'DGT Hydro' : 'Hydro DMG',
                        cryo_dmg_: isFr ? 'DGT Cryo' : 'Cryo DMG',
                        electro_dmg_: isFr ? 'DGT Électro' : 'Electro DMG',
                        anemo_dmg_: isFr ? 'DGT Anémo' : 'Anemo DMG',
                        geo_dmg_: isFr ? 'DGT Géo' : 'Geo DMG',
                        dendro_dmg_: isFr ? 'DGT Dendro' : 'Dendro DMG',
                        physical_dmg_: isFr ? 'DGT Phys.' : 'Phys. DMG'
                    };

                    let label = STAT_SHORT[statKey] || statKey;
                    let formattedVal = '';
                    const isPercent = statKey.endsWith('_') || ['critRate_', 'critDMG_', 'enerRech_'].includes(statKey);

                    if (isPercent) {
                        const pct = (val < 1.0 && val > -1.0) ? (val * 100) : val;
                        formattedVal = (pct >= 0 ? '+' : '') + pct.toFixed(1).replace('.0', '') + '%';
                    } else {
                        formattedVal = (val >= 0 ? '+' : '') + Math.round(val).toLocaleString();
                    }

                    return `<span style="display:inline-flex; align-items:center; gap:2px; font-size:10px; font-weight:normal; color:var(--accent-gold); background:rgba(255,215,0,0.12); border:none; border-radius:3px; padding:1px 5px; line-height:1.2;">${formattedVal} ${label}</span>`;
                }

                window.showTeammateTooltip = function (element) {
                    if (!element) return;
                    const slot = (element.closest ? element.closest('.team-mate-slot') : null) || element;
                    const raw = slot.getAttribute('data-teammate');
                    if (!raw) return;

                    let data;
                    try {
                        data = JSON.parse(decodeURIComponent(raw));
                    } catch (e) {
                        return;
                    }

                    let tooltip = document.getElementById('teammate-tooltip');
                    if (!tooltip) {
                        tooltip = document.createElement('div');
                        tooltip.id = 'teammate-tooltip';
                        document.body.appendChild(tooltip);
                    }

                    const lang = (window.GUOBA_LANG) || 'fr';
                    const primaryElem = (data.elements && data.elements[0]) ? String(data.elements[0]).toLowerCase() : 'pyro';
                    const elemColor = ELEMENT_COLORS_MAP[primaryElem] || data.color || 'var(--accent-gold)';
                    tooltip.style.setProperty('--tm-color', elemColor);

                    let weaponIcon = data.weaponIcon;
                    let weaponName = data.weaponName;
                    if (!weaponIcon && data.weaponKey) {
                        weaponIcon = window.ITEM_ICON_MAP?.[data.weaponKey] || (window.resolveIconFromKey && window.resolveIconFromKey(data.weaponKey));
                    }
                    if (!weaponName && data.weaponKey) {
                        weaponName = (window.getLocalizedItemName && window.getLocalizedItemName(data.weaponKey)) || data.weaponKey;
                    }

                    let artifactIcon = data.artifactIcon;
                    let artifactName = data.artifactName;
                    if (!artifactIcon && data.artifactKey) {
                        artifactIcon = window.ITEM_ICON_MAP?.[data.artifactKey] || (window.resolveIconFromKey && window.resolveIconFromKey(data.artifactKey));
                    }
                    if (!artifactName && data.artifactKey) {
                        artifactName = (window.getLocalizedItemName && window.getLocalizedItemName(data.artifactKey)) || data.artifactKey;
                    }

                    let portraitBg = data.bgStyle || '';
                    if (!portraitBg) {
                        portraitBg = `background: ${elemColor || '#333'};`;
                    } else if (!portraitBg.endsWith(';')) {
                        portraitBg += ';';
                    }

                    let avatarHtml = '';
                    if (data.isDual && data.avatarUrl && data.secondaryAvatarUrl) {
                        avatarHtml = `
                            <div style="position:relative; width:44px; height:44px; border-radius:5px; overflow:hidden; ${portraitBg} border:none; box-shadow:none; flex-shrink:0;">
                                <div style="position:absolute; inset:0; clip-path: polygon(0 0, 100% 0, 0 100%); z-index:2; pointer-events:none;">
                                    <img src="${data.avatarUrl}" style="width:100%; height:100%; object-fit:cover;" decoding="async">
                                </div>
                                <div style="position:absolute; inset:0; clip-path: polygon(100% 0, 100% 100%, 0 100%); z-index:1; pointer-events:none;">
                                    <img src="${data.secondaryAvatarUrl}" style="width:100%; height:100%; object-fit:cover;" decoding="async">
                                </div>
                                <div style="position:absolute; inset:0; background:linear-gradient(to bottom right, transparent 49.5%, var(--text-primary) 49.5%, var(--text-primary) 50.5%, transparent 50.5%); z-index:3; pointer-events:none;"></div>
                            </div>
                        `;
                    } else {
                        const imgFit = data.isArchetype ? 'object-fit:contain; padding:6px; box-sizing:border-box;' : 'object-fit:cover;';
                        avatarHtml = `
                            <div style="position:relative; width:44px; height:44px; border-radius:5px; overflow:hidden; ${portraitBg} border:none; box-shadow:none; flex-shrink:0;">
                                <img src="${data.avatarUrl || '/assets/simulator/icons/icon_empty_slot.svg'}" style="width:100%; height:100%; ${imgFit} pointer-events:none;" decoding="async" onerror="this.src='/assets/simulator/icons/icon_unknown.webp'">
                            </div>
                        `;
                    }

                    const displayName = data.isDual
                        ? `${data.resolvedName}${data.secondaryResolvedName ? ' / ' + data.secondaryResolvedName : ''}`
                        : (data.resolvedName || data.role);

                    const elemBadges = (data.elements || [primaryElem]).filter(Boolean).map(e => {
                        const elKey = String(e).toLowerCase();
                        const c = ELEMENT_COLORS_MAP[elKey] || '#888';
                        const label = (window.t && window.t(`ui.char.spider.stat.${elKey}`)) || elKey.charAt(0).toUpperCase() + elKey.slice(1);
                        return `
                            <span style="display:inline-flex; align-items:center; gap:3px; padding:1px 6px; border-radius:4px; font-size:10px; font-weight:normal; background:color-mix(in srgb, ${c} 22%, transparent); color:${c}; border:none;">
                                <img src="/assets/simulator/icons/icon_${elKey}.webp" style="width:11px; height:11px; object-fit:contain;" alt="${elKey}" onerror="this.style.display='none'">
                                <span>${label}</span>
                            </span>
                        `;
                    }).join('');

                    const roleBadge = data.role ? `
                        <span style="display:inline-flex; align-items:center; padding:1px 6px; border-radius:4px; font-size:10px; font-weight:normal; background:rgba(255,255,255,0.08); color:rgba(255,255,255,0.85); border:none;">
                            ${data.role}
                        </span>
                    ` : '';

                    let consBadge = '';
                    if (data.cons !== undefined && data.cons !== null && parseInt(data.cons) > 0) {
                        const consText = (window.t && window.t('ui.teammate.constellationRec', data.cons)) || `C${data.cons} recommandé`;
                        consBadge = `
                            <span style="display:inline-flex; align-items:center; padding:1px 6px; border-radius:4px; font-size:10px; font-weight:normal; background:linear-gradient(135deg, rgba(255,215,0,0.25), rgba(255,160,0,0.35)); color:#ffd700; border:none;">
                                ${consText}
                            </span>
                        `;
                    }

                    const buffsList = [];
                    const allyNames = Array.isArray(data.names) ? data.names : (data.names ? [data.names] : []);
                    const userCons = (data.cons !== null && data.cons !== undefined) ? parseInt(data.cons) : 6;

                    allyNames.forEach(n => {
                        if (!n) return;
                        const tmData = window.TEAMMATE_BUFFS?.[n];
                        if (tmData && tmData.buffs) {
                            tmData.buffs.forEach(b => {
                                if (b.cons !== undefined && userCons < b.cons) return;
                                const lbl = typeof b.label === 'object' ? (b.label[lang] || b.label.fr || b.label.en) : b.label;
                                buffsList.push({ label: lbl, stats: b.stats });
                            });
                        }
                    });

                    if (data.weaponKey && window.TEAMMATE_WEAPON_BUFFS?.[data.weaponKey]) {
                        const wData = window.TEAMMATE_WEAPON_BUFFS[data.weaponKey];
                        const wBuffs = wData.buffs || [wData];
                        wBuffs.forEach(b => {
                            const lbl = typeof b.label === 'object' ? (b.label[lang] || b.label.fr || b.label.en) : (b.label || weaponName);
                            buffsList.push({ label: lbl, stats: b.stats });
                        });
                    }

                    if (data.artifactKey && window.TEAMMATE_SET_BUFFS?.[data.artifactKey]) {
                        const sData = window.TEAMMATE_SET_BUFFS[data.artifactKey];
                        const sBuffs = sData.buffs || [sData];
                        sBuffs.forEach(b => {
                            const lbl = typeof b.label === 'object' ? (b.label[lang] || b.label.fr || b.label.en) : (b.label || artifactName);
                            buffsList.push({ label: lbl, stats: b.stats });
                        });
                    }

                    let buffsHtml = '';
                    if (buffsList.length > 0) {
                        const buffsTitle = (window.t && window.t('ui.teammate.teamBuffs')) || 'Buffs & effets apportés';
                        const buffItems = buffsList.map(b => {
                            let statsHtml = '';
                            if (b.stats && typeof b.stats === 'object') {
