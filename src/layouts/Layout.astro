---
// src/layouts/Layout.astro
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

interface Props {
    title?: string;
    titleKey?: string;
    description?: string;
    schema?: Record<string, any> | Array<Record<string, any>>;
}

const { title = "guoba.gg - Simulateur Genshin Impact", titleKey, description = "guoba.gg est un outil d'analyse de builds et de statistiques pour Genshin Impact. Évaluez vos artéfacts, optimisez vos personnages et générez des vitrines à partir de votre UID.", schema } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://guoba.clement-torchiat.fr").href;

const defaultSchema = {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "guoba.gg",
    url: "https://guoba.clement-torchiat.fr/",
    description: description,
    applicationCategory: "GameApplication",
    operatingSystem: "All",
    inLanguage: "fr",
    author: {
        "@type": "Person",
        name: "Clem",
    },
    offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "EUR",
    },
};

const finalSchema = schema || defaultSchema;
---

<!doctype html>
<html lang="fr" data-theme="wish">
    <head>
        <meta charset="UTF-8" />
        <ClientRouter />
        <script is:inline>
            (function initThemeLangAndZoom() {
                function apply() {
                    const W = window.screen.width;
                    if (W >= 3840) document.documentElement.style.zoom = "1.5";
                    else if (W >= 2560) document.documentElement.style.zoom = "1.25";
                    const savedTheme = localStorage.getItem("guoba_theme") || "wish";
                    document.documentElement.setAttribute("data-theme", savedTheme);

                    const storedLang = localStorage.getItem("guoba_lang");
                    const browserLang = navigator.language ? navigator.language.slice(0, 2) : "fr";
                    const lang = ["fr", "en"].includes(storedLang) ? storedLang : ["fr", "en"].includes(browserLang) ? browserLang : "fr";
                    document.documentElement.lang = lang;

                    const reduceTransp = localStorage.getItem("guoba_reduce_transparency") === "true";
                    if (reduceTransp) document.documentElement.classList.add("reduce-transparency");
                    else document.documentElement.classList.remove("reduce-transparency");
                }
                apply();
                document.addEventListener("astro:after-swap", apply);
            })();
        </script>
        <title data-i18n-title-tag={titleKey}>{title}</title>

        <!-- Balise canonique dynamique -->
        <link rel="canonical" href={canonicalURL} />

        <!-- Données structurées Schema.org JSON-LD -->
        <script type="application/ld+json" set:html={JSON.stringify(finalSchema)} />

        <!-- Preconnect & DNS-prefetch pour les connexions critiques -->
        <link rel="preconnect" href="https://enka.network" crossorigin />
        <link rel="dns-prefetch" href="https://enka.network" />

        <!-- Preload de la police personnalisée pour éviter les Flash of Unstyled Text (FOUT) -->
        <link rel="preload" href="/assets/global/typo/ShinShin.ttf" as="font" type="font/ttf" crossorigin="anonymous" />

        <link rel="icon" type="image/png" href="/assets/global/favicon.png" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="tdm-reservation" content="1" />
        <meta property="og:locale" content="fr_FR" />
        <meta name="robots" content="noindex, nofollow" />

        <meta name="description" content={description} />
        <meta name="keywords" content="Genshin Impact, build, simulateur, artéfacts, enka network, UID, statistiques, optimisation" />
        <meta name="author" content="clem" />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content="https://guoba.clement-torchiat.fr/assets/global/banner.png" />
        <meta property="og:site_name" content="guoba.gg" />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content="https://guoba.clement-torchiat.fr/assets/global/banner.png" />
        <meta name="theme-color" content="#1e2024" />

        <link rel="apple-touch-icon" href="/assets/global/favicon.png" />

        <script is:inline>
            window.toggleSidebarCollapse = function () {
                const sidebar = document.querySelector(".sidebar");
                const icon = document.getElementById("sidebar-collapse-icon");
                if (sidebar && sidebar.classList.contains("sidebar-collapsed")) {
                    sidebar.classList.remove("sidebar-collapsed");
                    if (icon) icon.style.transform = "rotate(90deg)";
                    localStorage.setItem("sidebarCollapsed", "false");
                } else if (sidebar) {
                    sidebar.classList.add("sidebar-collapsed");
                    if (icon) icon.style.transform = "rotate(-90deg)";
                    localStorage.setItem("sidebarCollapsed", "true");
                }
            };

            function restoreSidebarState() {
                const sidebar = document.querySelector(".sidebar");
                if (!sidebar) return;
                const isCollapsed = localStorage.getItem("sidebarCollapsed") === "true";
                const icon = document.getElementById("sidebar-collapse-icon");
                if (isCollapsed) {
                    sidebar.classList.add("sidebar-collapsed");
                    if (icon) icon.style.transform = "rotate(-90deg)";
                } else {
                    sidebar.classList.remove("sidebar-collapsed");
                    if (icon) icon.style.transform = "rotate(90deg)";
                }

                if (window.location.pathname !== "/") {
                    const wrapper = document.getElementById("user-account-wrapper");
                    if (wrapper) wrapper.style.display = "";
                }
            }

            function restoreGlobalSettings() {
                if (localStorage.getItem("guoba_reduce_transparency") === "true") {
                    document.documentElement.classList.add("reduce-transparency");
                } else {
                    document.documentElement.classList.remove("reduce-transparency");
                }
            }

            document.addEventListener("astro:page-load", () => {
                restoreSidebarState();
                restoreGlobalSettings();
            });
            document.addEventListener("astro:after-swap", () => {
                restoreSidebarState();
                restoreGlobalSettings();
            });

            restoreGlobalSettings(); // Apply immediately
        </script>
        <script>
            import "../scripts/auth.js";
        </script>
    </head>
    <body>
        <slot />
        <div id="global-tooltip"></div>
        <div id="combat-stat-tooltip"></div>
        <div id="artifact-stat-tooltip"></div>
        <div id="base-stat-tooltip"></div>
        <div id="login-modal-overlay" style="display: none; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0, 0, 0, 0.6); z-index: 9999; align-items: center; justify-content: center; backdrop-filter: blur(4px);">
            <div id="login-modal" style="background: var(--bg-panel); border-radius: 8px; padding: 24px; width: 90%; max-width: 440px; position: relative; display: flex; flex-direction: column; gap: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.5);">
                <button class="modal-close-btn" onclick="closeLoginModal()" style="position: absolute; top: 12px; right: 12px; background: none; border: none; cursor: pointer; width: 40px; height: 40px; border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
                <div style="text-align: center; margin-top: 10px;">
                    <h3 style="margin: 0 0 8px 0; color: var(--text-primary); font-size: 20px; font-weight: normal; text-align: left;" data-i18n="account.login.title">Créer un compte</h3>
                    <p style="margin: 0; color: var(--text-muted); font-size: 14px; text-align: left;" data-i18n="account.login.desc">Connectez-vous pour débloquer plus de fonctionnalités</p>
                </div>

                <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 12px; color: var(--text-primary); font-size: 14px; background: var(--bg-body); padding: 15px; border-radius: 8px;">
                    <li style="display: flex; align-items: center; gap: 10px;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#4ade80" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        <span data-i18n="account.login.feature1">Revendiquer la propriété d'un UID</span>
                    </li>
                    <li style="display: flex; align-items: center; gap: 10px;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#4ade80" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        <span data-i18n="account.login.feature2">Retrait des classements</span>
                    </li>
                    <li style="display: flex; align-items: center; gap: 10px;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#4ade80" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        <span data-i18n="account.login.feature3">Sauvegarder vos préférences d'affichage</span>
                    </li>
                </ul>

                <button style="background: #5865F2; color: white; border: none; border-radius: 8px; padding: 12px; font-weight: bold; font-size: 16px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 10px; transition: background 0.2s;" onmouseover="this.style.background='#4752C4'" onmouseout="this.style.background='#5865F2'" onclick="loginWithDiscord()">
                    <svg width="24" height="24" viewBox="0 0 127.14 96.36" fill="white" xmlns="http://www.w3.org/2000/svg">
                        <path d="M107.7,8.07A105.15,105.15,0,0,0,81.47,0a72.06,72.06,0,0,0-3.36,6.83A97.68,97.68,0,0,0,49,6.83,72.37,72.37,0,0,0,45.64,0,105.89,105.89,0,0,0,19.39,8.09C2.79,32.65-1.71,56.6.54,80.21h0A105.73,105.73,0,0,0,32.71,96.36,77.7,77.7,0,0,0,39.6,85.25a68.42,68.42,0,0,1-10.85-5.18c.91-.66,1.8-1.34,2.66-2a75.57,75.57,0,0,0,64.32,0c.87.71,1.76,1.39,2.66,2a68.68,68.68,0,0,1-10.87,5.19,77,77,0,0,0,6.89,11.1A105.25,105.25,0,0,0,126.6,80.22h0C129.24,52.84,122.09,29.11,107.7,8.07ZM42.45,65.69C36.18,65.69,31,60,31,53s5-12.74,11.43-12.74S54,46,53.89,53,48.84,65.69,42.45,65.69Zm42.24,0C78.41,65.69,73.31,60,73.31,53s5-12.74,11.43-12.74S96.2,46,96.12,53,91.08,65.69,84.69,65.69Z"></path>
                    </svg>
                    <span data-i18n="account.login.button">Se connecter avec Discord</span>
                </button>
            </div>
        </div>

        <script is:inline>
            function openLoginModal() {
                const modal = document.getElementById("login-modal-overlay");
                if (modal) {
                    modal.style.display = "flex";
                    modal.style.opacity = "0";
                    setTimeout(() => {
                        modal.style.transition = "opacity 0.2s";
                        modal.style.opacity = "1";
                    }, 10);
                }
            }

            function closeLoginModal() {
                const modal = document.getElementById("login-modal-overlay");
                if (modal) {
                    modal.style.opacity = "0";
                    setTimeout(() => {
                        modal.style.display = "none";
                    }, 200);
                }
            }

            function toggleReduceTransparency(checked) {
                localStorage.setItem("guoba_reduce_transparency", checked);
                if (checked) {
                    document.documentElement.classList.add("reduce-transparency");
                } else {
                    document.documentElement.classList.remove("reduce-transparency");
                }
            }

            function openSettingsModal() {
                const modal = document.getElementById("settings-modal-overlay");
                if (modal) {
                    const reduceCb = document.getElementById("reduce-transparency-checkbox");
                    if (reduceCb) {
                        reduceCb.checked = localStorage.getItem("guoba_reduce_transparency") === "true";
                    }
                    modal.style.display = "flex";
                    modal.style.opacity = "0";
                    setTimeout(() => {
                        modal.style.transition = "opacity 0.2s";
                        modal.style.opacity = "1";
                    }, 10);
                }
            }

            function closeSettingsModal() {
                const modal = document.getElementById("settings-modal-overlay");
                if (modal) {
                    modal.style.opacity = "0";
                    setTimeout(() => {
                        modal.style.display = "none";
                    }, 200);
                }
            }
        </script>

        <!-- SETTINGS MODAL -->
        <div id="settings-modal-overlay" style="display: none; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0, 0, 0, 0.6); z-index: 9999; align-items: center; justify-content: center; backdrop-filter: blur(4px);">
            <div id="settings-modal" style="background: var(--bg-panel); border-radius: 8px; padding: 24px; width: 90%; max-width: 500px; position: relative; display: flex; flex-direction: column; gap: 24px; box-shadow: 0 10px 30px rgba(0,0,0,0.5);">
                <button class="modal-close-btn" onclick="closeSettingsModal()" style="position: absolute; top: 12px; right: 12px; background: none; border: none; cursor: pointer; width: 40px; height: 40px; border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
                <div style="text-align: left; margin-top: 10px;">
                    <h3 style="margin: 0 0 8px 0; color: var(--text-primary); font-size: 20px; font-weight: normal; padding-left: 15px;" data-i18n="account.settings.title">Paramètres du compte</h3>
                </div>

                <div style="background: var(--bg-body); padding: 15px; border-radius: 8px; display: flex; flex-direction: column; gap: 12px; padding-top:0;">
                    <!-- VUE NON LIÉ -->
                    <div id="settings-unlinked-view" style="display: flex; flex-direction: column; gap: 12px;">
                        <h4 style="margin: 0; color: var(--text-primary); font-size: 16px; font-weight: normal;" data-i18n="account.settings.linkTitle">Lier un compte Genshin</h4>

                        <div class="timeline-container">
                            <div class="timeline-step" id="timeline-step-1">
                                <div class="timeline-icon"></div>
                                <div class="timeline-content">
                                    <span style="color: var(--text-muted); font-size: 13px;"><strong data-i18n="account.settings.step1">Étape 1 :</strong> <span data-i18n="account.settings.step1Desc">Entrez votre UID Genshin ci-dessous.</span></span>
                                    <div style="display: flex; gap: 8px; margin-top: 12px;">
                                        <input type="text" id="link-uid-input" data-i18n-placeholder="account.settings.placeholder" placeholder="Votre UID" style="flex: 1; padding: 10px; border-radius: 8px; border: none; background: rgb(0,0,0,0.2); color: var(--text-primary); font-family: inherit;" onkeydown="if(event.key === 'Enter') generateVerificationCode()" />
                                        <button id="generate-code-btn" onclick="generateVerificationCode()" data-i18n="account.settings.generate">Générer un code</button>
                                    </div>
                                    <p id="uid-format-error" style="color: #ef4444; font-size: 12px; margin: 8px 0 0 0; display: none;" data-i18n="account.settings.errorFormat">Veuillez entrer un UID valide (constitué uniquement de chiffres, 9 à 10 caractères).</p>
                                </div>
                            </div>

                            <div id="verification-step" style="display: none;">
                                <div class="timeline-step step-anim" style="animation-delay: 0.1s;">
                                    <div class="timeline-icon"></div>
                                    <div class="timeline-content">
                                        <span style="color: var(--text-muted); font-size: 13px;"><strong data-i18n="account.settings.step2">Étape 2 :</strong> <span data-i18n="account.settings.step2Desc">Copiez ce code dans votre signature en jeu.</span></span>
                                        <div style="background: var(--bg-panel); padding: 10px; border-radius: 6px; border: 1px dashed var(--text-muted); text-align: center; margin-top: 10px;">
                                            <span id="verification-code-display" style="color: var(--text-primary); font-size: 18px; letter-spacing: 2px;">guoba-xxxx</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="timeline-step step-anim" style="animation-delay: 0.2s;">
                                    <div class="timeline-icon"></div>
                                    <div class="timeline-content">
                                        <span style="color: var(--text-muted); font-size: 13px;"><strong data-i18n="account.settings.step3">Étape 3 :</strong> <span data-i18n="account.settings.step3Desc">Déconnectez-vous du jeu pour qu'il actualise les données de votre profil.</span></span>
                                    </div>
                                </div>

                                <div class="timeline-step last-step step-anim" style="animation-delay: 0.3s; padding-bottom: 0;">
                                    <div class="timeline-icon"></div>
                                    <div class="timeline-content">
                                        <span style="color: var(--text-muted); font-size: 13px;"><strong data-i18n="account.settings.step4">Étape 4 :</strong> <span data-i18n="account.settings.step4Desc">Cliquez sur Vérifier.</span></span>
                                        <button id="verify-code-btn" onclick="verifyUidSignature()" data-i18n="account.settings.verify">Vérifier</button>
                                        <p id="verification-error" style="color: #ef4444; font-size: 12px; margin: 8px 0 0 0; display: none;" data-i18n="account.settings.errorVerify">Signature introuvable ou incorrecte. Assurez-vous d'avoir bien quitté le profil en jeu pour que la sauvegarde s'effectue.</p>
                                        <p id="verification-success" style="color: var(--accent-gold); font-size: 12px; margin: 8px 0 0 0; display: none;" data-i18n="account.settings.success">Compte associé avec succès !</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- VUE LIÉ -->
                    <div id="settings-linked-view" style="display: none; flex-direction: column; gap: 12px;">
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <h4 style="margin: 0; color: var(--text-primary); font-size: 16px; font-weight: normal;" data-i18n="account.settings.linkedTitle">Compte Genshin associé</h4>
                            <button onclick="unlinkUid()" class="button-unlink" data-i18n="account.settings.unlink">Délier le compte</button>
                        </div>

                        <div class="player-profile-card" style="margin-top: 5px; height: 80px; box-shadow: 0 4px 15px rgba(0,0,0,0.3);">
                            <div class="player-profile-bg" id="settings-linked-bg" style="background-image: url('https://enka.network/ui/namecard/UI_NameCardPic_0_P.png');"></div>
                            <div class="player-profile-content">
                                <img class="player-profile-avatar" id="settings-linked-avatar" src="https://enka.network/ui/UI_AvatarIcon_PlayerBoy_Circle.png" />
                                <div class="player-profile-identity">
                                    <div class="player-profile-name-row">
                                        <span class="player-profile-name" id="settings-linked-name">Joueur</span>
                                        <span class="player-profile-uid" id="settings-linked-uid" style="text-decoration: none;">UID</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div id="settings-preferences-view" style="background: var(--bg-body); padding: 15px; border-radius: 8px; display: none; flex-direction: column; gap: 12px;">
                    <h4 style="margin: 0; color: var(--text-primary); font-size: 16px; font-weight: normal;" data-i18n="account.settings.preferences">Préférences</h4>
                    <label style="display: flex; align-items: center; justify-content: space-between; cursor: pointer; color: var(--text-primary); font-size: 14px;">
                        <span data-i18n="account.settings.optout">Ne pas apparaître dans les classements (Opt-out)</span>
                        <div class="toggle-switch">
                            <input type="checkbox" id="leaderboard-optout-checkbox" onchange="toggleLeaderboardOptOut(this.checked)" />
                            <span class="toggle-slider"></span>
                        </div>
                    </label>
                    <label style="display: flex; align-items: center; justify-content: space-between; cursor: pointer; color: var(--text-primary); font-size: 14px;">
                        <span data-i18n="account.settings.reduceTransparency">Réduire les effets de transparence</span>
                        <div class="toggle-switch">
                            <input type="checkbox" id="reduce-transparency-checkbox" onchange="toggleReduceTransparency(this.checked)" />
                            <span class="toggle-slider"></span>
                        </div>
                    </label>
                </div>

                <button onclick="logoutUser()" class="button-logout" data-i18n="account.settings.logout">Se déconnecter</button>
            </div>
        </div>
    </body>
</html>
