                    }
                };
            }

            function openSettingsModal() {
                const modal = document.getElementById("settings-modal-overlay");
                if (modal) {
                    const updateDiscordBtn = document.getElementById("settings-update-discord-btn");
                    if (updateDiscordBtn) {
                        const userAccount = document.getElementById("user-account");
                        const isConnected = userAccount && userAccount.style.display !== "none";
                        updateDiscordBtn.style.display = isConnected ? "flex" : "none";
                    }

                    const reduceCb = document.getElementById("reduce-transparency-checkbox");
                    if (reduceCb) {
                        reduceCb.checked = localStorage.getItem("guoba_reduce_transparency") === "true";
                    }
                    const sidebarPref = localStorage.getItem("guoba_sidebar_display") || "score_grade";
                    const sidebarLabel = document.getElementById("active-sidebar-display-text");
                    if (sidebarLabel) {
                        const keys = {
                            score_grade: "account.settings.sidebarDisplay.score",
                            top_percent: "account.settings.sidebarDisplay.top",
                            both: "account.settings.sidebarDisplay.both",
                        };
                        const key = keys[sidebarPref] || keys["score_grade"];
                        sidebarLabel.setAttribute("data-i18n", key);
                        if (typeof window !== "undefined" && window.t) {
                            sidebarLabel.innerText = window.t(key);
                        }
                    }
                    document.querySelectorAll('#sidebar-display-custom-menu .custom-select-item').forEach(item => {
                        if (item.getAttribute('data-value') === sidebarPref) {
                            item.classList.add('active');
                        } else {
                            item.classList.remove('active');
                        }
                    });

                    const decimalsPref = localStorage.getItem("guoba_ranking_decimals") || "1";
                    const decimalsLabel = document.getElementById("active-ranking-decimals-text");
                    if (decimalsLabel) {
                        const keys = {
                            "0": "account.settings.decimals0",
                            "1": "account.settings.decimals1",
                            "2": "account.settings.decimals2",
                        };
                        const key = keys[decimalsPref] || keys["1"];
                        decimalsLabel.setAttribute("data-i18n", key);
                        if (typeof window !== "undefined" && window.t) {
                            decimalsLabel.innerText = window.t(key);
                        }
                    }
                    document.querySelectorAll('#ranking-decimals-custom-menu .custom-select-item').forEach(item => {
                        if (item.getAttribute('data-value') === decimalsPref) {
                            item.classList.add('active');
                        } else {
                            item.classList.remove('active');
                        }
                    });

                    modal.style.display = "flex";
                    modal.style.opacity = "0";
                    setTimeout(() => {
                        modal.style.transition = "opacity 0.2s";
                        modal.style.opacity = "1";
                    }, 10);
                }
            }

            function closeSettingsModal() {
                if (window.hideGlobalTooltip) window.hideGlobalTooltip();
                const modal = document.getElementById("settings-modal-overlay");
                if (modal) {
                    modal.style.opacity = "0";
                    setTimeout(() => {
                        modal.style.display = "none";
                    }, 200);
                }
            }

            function toggleSidebarDisplayMenu(event) {
                event.stopPropagation();
                const menu = document.getElementById("sidebar-display-custom-menu");
                document.querySelectorAll(".custom-select-menu").forEach((m) => {
                    if (m !== menu) m.classList.remove("show");
                });
                if (menu) menu.classList.toggle("show");
            }

            function toggleRankingDecimalsMenu(event) {
                event.stopPropagation();
