---
import Layout from "../../layouts/Layout.astro";
import StaticLayout from "../../layouts/StaticLayout.astro";
import { createClient } from '@supabase/supabase-js';

// Dictionnaire
import leaderboardsNames from "../../data/leaderboards_names.json";
import { getEnkaAvatars } from "../../server/enkaParser";
export const prerender = false;

const { id } = Astro.params;
if (!id) {
  return Astro.redirect('/leaderboards');
}

// 1. Setup Supabase
const supabase = createClient(
  import.meta.env.SUPABASE_URL,
  import.meta.env.SUPABASE_SERVICE_KEY
);

const ENKA_TO_LOCAL_NAME: Record<string, string> = {
  "Alhatham": "Alhaitham", "Ambor": "Amber", "Itto": "Arataki_Itto", "Baizhuer": "Baizhu",
  "Freminet": "Fréminet", "Hutao": "Hu_Tao", "Qin": "Jean", "Kazuha": "Kaedehara_Kazuha",
  "Ayaka": "Kamisato_Ayaka", "Ayato": "Kamisato_Ayato", "Momoka": "Kirara", "Sara": "Kujou_Sara",
  "Shinobu": "Kuki_Shinobu", "Lanyan": "Lan_Yan", "Liney": "Lyney", "Wanderer": "Nomade",
  "Noel": "Noëlle", "Olorun": "Ororon", "Rosaria": "Rosalia", "MarionetteNew": "Sandrone",
  "Kokomi": "Sangonomiya_Kokomi", "Heizo": "Shikanoin_Heizou", "Shougun": "Shogun_Raiden",
  "Tohma": "Thomas", "Liuyun": "Xianyun", "Yae": "Yae_Miko", "Feiyan": "Yanfei",
  "Mizuki": "Yumemizuki_Mizuki", "Yunjin": "Yun_Jin", "Linette": "Lynette", "SkirkNew": "Skirk",
  "Emilie": "Émilie"
};

const LOCAL_TO_ENKA_NAME: Record<string, string> = {};
for (const [enka, local] of Object.entries(ENKA_TO_LOCAL_NAME)) {
  LOCAL_TO_ENKA_NAME[local] = enka;
}

// 2. Charger les configs pour trouver à quel perso appartient cet ID
const charConfigsLoaders = import.meta.glob('../../../data/characters/*.json', { eager: true });
const CHAR_CONFIGS: Record<string, any> = {};
for (const path in charConfigsLoaders) {
  const fileName = path.split('/').pop()?.replace('.json', '') || "";
  CHAR_CONFIGS[fileName] = (charConfigsLoaders[path] as any).default || charConfigsLoaders[path];
}

const avatarsDb = await getEnkaAvatars();
const enkaAvatarMap: Record<string, any> = {};
for (const avatarId in avatarsDb) {
  const avatar = avatarsDb[avatarId];
  if (avatar.SideIconName) {
    let cleanName = avatar.SideIconName.replace("/ui/UI_AvatarIcon_Side_", "").replace(".png", "");
    enkaAvatarMap[cleanName] = avatar;
  }
}

let targetCharName = "";
let targetCharConfig: any = null;
let allTeamsForThisId: any[] = [];
let allErReqs = new Set<number>();

for (const charName in CHAR_CONFIGS) {
  const config = CHAR_CONFIGS[charName];
  let found = false;
  
  for (const [buildName, buildData] of Object.entries(config.builds)) {
    const data = buildData as any;
    const lbId = data.leaderboard_id || buildName;
    if (lbId === id) {
      found = true;
      if (data.team) allTeamsForThisId.push(data.team);
      if (data.er_req) allErReqs.add(data.er_req);
    }
  }

  if (found) {
    targetCharName = charName;
    targetCharConfig = config;
    break; // On a trouvé le propriétaire du leaderboard
  }
}

// Redirection si le leaderboard n'existe pas
if (!targetCharConfig) {
  return Astro.redirect('/leaderboards');
}

// Données du personnage
const charColor = targetCharConfig.color || "#5053bb";
const enkaName = LOCAL_TO_ENKA_NAME[targetCharName] || targetCharName;
const isTraveler = enkaName.includes("Traveler") || enkaName.includes("Voyageur") || enkaName.includes("Manekin") || enkaName.includes("Player");
const finalEnkaName = isTraveler ? "PlayerBoy" : enkaName;
const enkaAvatarImg = `https://enka.network/ui/UI_AvatarIcon_${finalEnkaName}.png`;
const enkaGachaImg = `https://enka.network/ui/UI_Gacha_AvatarImg_${finalEnkaName}.webp`;

const ELEMENT_COLORS: Record<string, string> = {
  "pyro": "#884A20", "hydro": "#195293", "dendro": "#516514", "electro": "#512C88",
  "anemo": "#2B7C6C", "cryo": "#1B7A92", "geo": "#886D01", "physical": "#cccccc"
};

const lbNameObj = leaderboardsNames[id as keyof typeof leaderboardsNames];
const lbDisplayName = lbNameObj ? lbNameObj.fr : id;

// 3. Traiter les teams et les ER Recommandées
// Si plusieurs teams, on utilisera la première par défaut
const defaultTeam = allTeamsForThisId.length > 0 ? allTeamsForThisId[0] : [];
const sortedErReqs = Array.from(allErReqs).sort((a, b) => b - a);
const lowestEr = sortedErReqs.length > 0 ? sortedErReqs[sortedErReqs.length - 1] : null;

const otherErs: number[] = [];
if (lowestEr) {
  for (let i = 1; i <= 3; i++) {
    const nextEr = lowestEr - (10 * i);
    if (nextEr >= 100) otherErs.push(nextEr);
  }
}
if (!sortedErReqs.includes(100) && !otherErs.includes(100)) {
  otherErs.push(100);
}
otherErs.sort((a, b) => b - a);

// 4. Récupérer les données Supabase du classement
const { data: builds, error } = await supabase
  .from('builds')
  .select('*, players(nickname, profile_picture)')
  .eq('archetype', id)
  .order('score', { ascending: false })
  .limit(100);

const entries = builds || [];

let mainElem = 'physical';
let mainWeapon = 'sword';
const enkaMap: Record<string, string> = { "Fire": "pyro", "Water": "hydro", "Grass": "dendro", "Electric": "electro", "Wind": "anemo", "Ice": "cryo", "Rock": "geo" };

// On cherche les infos officielles depuis Enka
if (enkaAvatarMap[finalEnkaName]) {
  const enkaAvatar = enkaAvatarMap[finalEnkaName];
  
  if (enkaAvatar.Element) {
    mainElem = enkaMap[enkaAvatar.Element] || enkaAvatar.Element.toLowerCase();
  }
  if (enkaAvatar.WeaponType) {
    mainWeapon = enkaAvatar.WeaponType.toLowerCase().replace('weapon_', '').replace('_one_hand', '').replace('pole', 'polearm');
  }
}

---

<Layout title={`${lbDisplayName} - ${targetCharName.replace(/_/g, ' ')} — guoba.gg`} titleKey="nav.leaderboards" description="Consultez les meilleurs builds sur guoba.gg.">
  <StaticLayout currentPage="leaderboards">
    <div class="static-page">
      <div class="static-page-hero">
        <h1 class="static-page-title">Classements</h1>
        <p class="static-page-lead">Parcourez les classements basés sur le score et le grade.</p>
      </div>

      <div class="leaderboard-content" style="margin-top: 20px;">
        <div class="leaderboard-details-tools" style="display: flex; flex-direction: row; justify-content: space-between;">
          <a href="/leaderboards" style="text-decoration: none;">
            <button style="font-family: Shinshin, sans-serif; display:inline-flex; align-items:center; padding:5px 11px; border-radius:8px; font-size:11px; font-weight:normal; cursor:pointer; transition:all 0.2s ease; border:1px solid rgba(255,255,255,0); background: var(--bg-panel); color:var(--text-primary);">
              <span>Revenir aux classements</span>
            </button>
          </a>
        </div>

        <div class="leaderboard-info" style={`display: flex; flex-direction: row; position:relative; padding:7px; overflow:hidden; background-color: rgb(from ${charColor} calc(r / 3.5) calc(g / 3.5) calc(b / 3.5) / 0.765); margin-top: 8px; border-radius: 8px;`}>
          <div style={`position: absolute; inset: 0; background-image: url('${enkaGachaImg}'); background-position: center center; background-repeat: no-repeat; background-size: 200%; z-index: 0; filter: blur(10px) brightness(0.7) saturate(0.8);`}></div>
          <div style={`position: absolute; inset: 0; background-color: rgb(from ${charColor} calc(r / 3.5) calc(g / 3.5) calc(b / 3.5) / 0.765); transition: background-color 0.35s; z-index: 1;`}></div>
          
          <div class="leaderboard-info-left" style="display: flex; flex-direction: column; gap: 16px; z-index: 1;">
            <div class="leaderboard-info-left-name" style="display: flex; flex-direction: row; gap: 18px; align-items: center;">
              <img src={enkaAvatarImg} style="width: 86px; height:86px; border-radius: 8px; background-color: rgba(0, 0, 0, 0.4);" onerror={`this.onerror=null; this.src='https://enka.network/ui/UI_AvatarIcon_${targetCharName.split('_')[0]}.png'`} />
              <div class="leaderboard-info-left-name-container" style="display:flex; flex-direction: column;">
                <div class="leaderboard-info-left-name-container-icons" style="display: flex; flex-direction: row;">
                  <img src={`/assets/simulator/icons/icon_${mainElem}.webp`} style="width: 21px; height: 21px;" />
                  <img src={`/assets/simulator/icons/icon_${mainWeapon}.webp`} style="width: 21px; height: 21px;" />
                </div>
                <p style="font-size: 22px;">{targetCharName.replace(/_/g, ' ')}</p>
                <p style="font-size: 18px; opacity: 0.5;">{lbDisplayName}</p>
              </div>
            </div>

            <div class="leaderboard-info-left-team" style="border-radius: 8px; background-color: rgba(0, 0, 0, 0.4); padding: 8px 18px 18px 18px; display:flex; flex-direction: column; gap: 16px;">
              <div class="leaderboard-info-left-team-title" style="display:flex; flex-direction: row; justify-content: space-between; gap:16px;">
                <div style="display: flex; flex-direction: row; align-items: center; gap: 8px;">
                  <p>Équipe associée</p>
                  <svg width="15" height="15" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M14 7.5C14 3.91015 11.0899 1 7.5 1C3.91015 1 1 3.91015 1 7.5C1 11.0899 3.91015 14 7.5 14V15C3.35786 15 0 11.6421 0 7.5C0 3.35786 3.35786 0 7.5 0C11.6421 0 15 3.35786 15 7.5C15 11.6421 11.6421 15 7.5 15V14C11.0899 14 14 11.0899 14 7.5Z" fill="white"></path>
                    <path d="M9.95301 5.49967C9.84324 4.97607 9.53223 4.5997 9.03915 4.35734C8.52821 4.10547 7.97109 4.03764 7.43358 4C6.49445 4.01613 5.75831 4.35072 5.24519 5.08029C5.11582 5.26434 4.97469 5.45211 5.00387 5.69488C5.03393 5.94345 5.28004 6.07994 5.50741 5.95751C5.65464 5.87852 5.79926 5.7776 5.90902 5.65725C6.29626 5.23208 6.76321 5.0104 7.36563 5.06747C7.74676 5.10387 8.10656 5.37642 8.16449 5.68909C8.23244 6.05719 8.04296 6.35332 7.62131 6.51172C7.43532 6.58162 7.23713 6.62174 7.04765 6.6846C6.68742 6.80413 6.44915 7.02498 6.36203 7.39391C6.21524 8.01553 6.4387 8.53003 6.84074 8.99821C6.95356 9.12932 7.1095 9.19095 7.28678 9.15579C7.46276 9.12105 7.5538 8.98953 7.60433 8.83898C7.65093 8.69919 7.67881 8.55361 7.71192 8.40968C7.81167 7.97872 7.99635 7.81287 8.45721 7.73305C9.074 7.62634 9.57492 7.35958 9.82321 6.78262C10.0005 6.37069 10.0458 5.94138 9.95301 5.49967Z" fill="white"></path>
                    <path d="M7.21796 9.29683C6.68263 9.30096 6.31586 9.64879 6.31804 10.1501C6.32022 10.6542 6.68567 10.9971 7.22362 11C7.7546 11.0029 8.11875 10.6542 8.11745 10.1451C8.11571 9.63349 7.7546 9.29269 7.21796 9.29683Z" fill="white"></path>
                  </svg>
                </div>
                {allTeamsForThisId.length > 1 && (
                  <button type="button" style="display:inline-flex; align-items:center; gap:6px; height:36px; padding:0 14px; box-sizing:border-box; border-radius:8px; font-size:12px; font-weight:normal; cursor:pointer; transition:all 0.2s ease; border:1px solid transparent; background:rgba(0, 0, 0, 0.25); color:var(--text-always-white); font-family: Shinshin, sans-serif;">
                    <span style="pointer-events:none;">Variante 1</span>
                    <svg class="focus-chevron" style="width:14px; height:14px; transition:transform 0.2s ease; margin-left:4px; opacity:0.8; pointer-events:none;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                  </button>
                )}
              </div>
              <div class="leaderboard-info-left-teammates" style="display: flex; flex-direction: row; gap: 8px;">
                {(() => {
                  const mainCharBg = ELEMENT_COLORS[mainElem] || "#333";
                  
                  const teamDisplay: { isMain: boolean; iconUrl: string; bg: string; }[] = [];
                  teamDisplay.push({
                    isMain: true,
                    iconUrl: enkaAvatarImg,
                    bg: mainCharBg
                  });

                  for (let i = 0; i < 3; i++) {
                    const ally = defaultTeam[i];
                    if (ally) {
                      const rawName = Array.isArray(ally.name) ? (ally.name[0] || "") : (ally.name || "");
                      const allyImgName = rawName ? rawName.replace(/ /g, '_') : "";
                      const allyEnkaName = LOCAL_TO_ENKA_NAME[allyImgName] || allyImgName;
                      const isAllyTraveler = allyEnkaName.includes("Traveler") || allyEnkaName.includes("Voyageur") || allyEnkaName.includes("Manekin") || allyEnkaName.includes("Player");
                      const finalAllyEnkaName = isAllyTraveler ? "PlayerBoy" : allyEnkaName;
                      
                      const allyElem = Array.isArray(ally.element) ? ally.element[0] : ally.element;
                      const bg = allyElem ? (ELEMENT_COLORS[allyElem.toLowerCase()] || "#333") : "#333";
                      
                      let iconUrl = "";
                      if (finalAllyEnkaName && !['Unknown', '?', ''].includes(finalAllyEnkaName)) {
                        iconUrl = `https://enka.network/ui/UI_AvatarIcon_${finalAllyEnkaName}.png`;
                      } else if (allyElem) {
                        iconUrl = `/assets/simulator/icons/icon_${allyElem.toLowerCase()}.webp`;
                      } else {
                        iconUrl = `/assets/simulator/icons/icon_empty_slot.svg`;
                      }
                      
                      teamDisplay.push({ isMain: false, iconUrl, bg });
                    } else {
                      teamDisplay.push({ isMain: false, iconUrl: `/assets/simulator/icons/icon_empty_slot.svg`, bg: "rgba(0,0,0,0.4)" });
                    }
                  }

                  return teamDisplay.map(member => (
                    <img 
                      style={`width: 80px; height: 80px; border-radius: 8px; background: ${member.bg}; ${member.isMain ? 'border: 2px solid rgba(255, 255, 255, 0.5);' : ''}`} 
                      src={member.iconUrl} 
                      onerror="this.onerror=null; this.style.display='none'"
                    />
                  ));
                })()}
              </div>
            </div>

            <div class="leaderboard-info-left-er" style="display:flex; flex-direction: column; gap: 8px; margin-left: 10px;">
              {sortedErReqs.length > 0 && (
                <div style="display: flex; flex-direction: row; align-items: center; gap: 8px;">
                  <p style="font-size: 14px;">ER Recommandée :</p>
                  <svg width="15" height="15" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M14 7.5C14 3.91015 11.0899 1 7.5 1C3.91015 1 1 3.91015 1 7.5C1 11.0899 3.91015 14 7.5 14V15C3.35786 15 0 11.6421 0 7.5C0 3.35786 3.35786 0 7.5 0C11.6421 0 15 3.35786 15 7.5C15 11.6421 11.6421 15 7.5 15V14C11.0899 14 14 11.0899 14 7.5Z" fill="white"></path>
                    <path d="M9.95301 5.49967C9.84324 4.97607 9.53223 4.5997 9.03915 4.35734C8.52821 4.10547 7.97109 4.03764 7.43358 4C6.49445 4.01613 5.75831 4.35072 5.24519 5.08029C5.11582 5.26434 4.97469 5.45211 5.00387 5.69488C5.03393 5.94345 5.28004 6.07994 5.50741 5.95751C5.65464 5.87852 5.79926 5.7776 5.90902 5.65725C6.29626 5.23208 6.76321 5.0104 7.36563 5.06747C7.74676 5.10387 8.10656 5.37642 8.16449 5.68909C8.23244 6.05719 8.04296 6.35332 7.62131 6.51172C7.43532 6.58162 7.23713 6.62174 7.04765 6.6846C6.68742 6.80413 6.44915 7.02498 6.36203 7.39391C6.21524 8.01553 6.4387 8.53003 6.84074 8.99821C6.95356 9.12932 7.1095 9.19095 7.28678 9.15579C7.46276 9.12105 7.5538 8.98953 7.60433 8.83898C7.65093 8.69919 7.67881 8.55361 7.71192 8.40968C7.81167 7.97872 7.99635 7.81287 8.45721 7.73305C9.074 7.62634 9.57492 7.35958 9.82321 6.78262C10.0005 6.37069 10.0458 5.94138 9.95301 5.49967Z" fill="white"></path>
                    <path d="M7.21796 9.29683C6.68263 9.30096 6.31586 9.64879 6.31804 10.1501C6.32022 10.6542 6.68567 10.9971 7.22362 11C7.7546 11.0029 8.11875 10.6542 8.11745 10.1451C8.11571 9.63349 7.7546 9.29269 7.21796 9.29683Z" fill="white"></path>
                  </svg>
                  {sortedErReqs.map((er, index) => {
                    const isDefault = index === 0;
                    return (
                      <button data-filter-er={er} class="er-filter-btn" style={`font-family: Shinshin, sans-serif; display:inline-flex; align-items:center; padding:5px 11px; border-radius:8px; font-size:11px; font-weight:normal; cursor:pointer; transition:all 0.2s ease; border:1px solid ${isDefault ? '#3b82f6' : 'rgba(255,255,255,0)'}; background: ${isDefault ? 'rgba(59,130,246,0.18)' : 'rgba(0, 0, 0, 0.25)'}; color:var(--text-primary);`}>
                        <span style={`color: ${isDefault ? '#60a5fa' : 'var(--text-primary)'};`}>≥{er}%</span>
                      </button>
                    );
                  })}
                </div>
              )}
              {otherErs.length > 0 && (
                <div style="display: flex; flex-direction: row; align-items: center; gap: 8px;">
                  <p style="font-size: 14px; opacity: 0.5;">Autres ER :</p>
                  {otherErs.map(er => (
                    <button data-filter-er={er} class="er-filter-btn" style="font-family: Shinshin, sans-serif; display:inline-flex; align-items:center; padding:5px 11px; border-radius:8px; font-size:11px; font-weight:normal; cursor:pointer; transition:all 0.2s ease; border:1px solid rgba(255,255,255,0); background: rgba(0, 0, 0, 0.25); color:var(--text-primary);">
                      <span>≥{er}%</span>
                    </button>
                  ))}
                </div>
              )}
            </div>
          </div>
          <div class="leaderboard-info-right"></div>
        </div>

        <div class="leaderboards-container" style="background: var(--bg-panel); border-radius: 8px; margin-top: 24px; padding: 5px;">
          <div class="leaderboards-head" style="display: flex; flex-direction: row; justify-content: space-between; margin: 7px 20px 10px 10px">
            <p style="font-size: 12px; flex: 0.2;">#</p>
            <p style="font-size: 12px; flex: 1;">Propriétaire</p>
            <p style="font-size: 12px; flex: 0.5; text-align: center;">Set</p>
            <p style="font-size: 12px; flex: 1; text-align: center;">Ratio de CRIT</p>
            <p style="font-size: 12px; flex: 1; text-align: center;">Recharge</p>
            <p style="font-size: 12px; flex: 0.5; text-align: right;">Score</p>
          </div>

          <div class="leaderboard-list-rows" style="display: flex; flex-direction: column; gap: 5px;">
            {entries.length === 0 ? (
              <div style="padding: 20px; text-align: center; color: var(--text-grey);">
                Aucune entrée trouvée pour ce classement pour le moment.
              </div>
            ) : entries.map((build: any, index: number) => {
              const player = build.players;
              const data = build.data;
              const evalData = data.evaluation || {};
              
              // Fallback pour les stats globales
              const stats = data.stats || { critRate: 0.05, critDMG: 0.50, enerRech: 1.00 };
              
              // Calcul manuel du CV et des sets à partir des artefacts
              let totalCV = 0;
              const setsCounter: { [key: string]: number } = {};
              
              if (data.artefacts) {
                data.artefacts.forEach((art: any) => {
                  if (art.setKey) setsCounter[art.setKey] = (setsCounter[art.setKey] || 0) + 1;
                  
                  if (art.mainStat) {
                    if (art.mainStat.key === 'critRate_') totalCV += art.mainStat.value * 2;
                    if (art.mainStat.key === 'critDMG_') totalCV += art.mainStat.value;
                  }
                  
                  if (art.subStats) {
                    art.subStats.forEach((sub: any) => {
                      if (sub.key === 'critRate_') totalCV += sub.value * 2;
                      if (sub.key === 'critDMG_') totalCV += sub.value;
                    });
                  }
                });
              }
              
              const sortedSets = Object.entries(setsCounter).sort((a,b) => b[1] - a[1]);
              const bestSetName = sortedSets.length > 0 ? sortedSets[0][0] : null;
              const bestSetCount = sortedSets.length > 0 ? sortedSets[0][1] : 0;
              
              const bgColor = index % 2 === 0 ? 'rgba(0, 0, 0, 0.2)' : 'var(--bg-panel)';
              
              // Helper pour le serveur
              const serverPrefix = build.uid ? build.uid[0] : '7';
              const serverName = serverPrefix === '7' ? 'EU' : serverPrefix === '6' ? 'NA' : 'AS';
              
              return (
                <div class="leaderboard-list-row" data-er={Math.round((stats.enerRech || 1) * 100)} style={`position: relative; overflow: hidden; padding: 10px; padding-right: 20px; padding-left: 10px; border-radius: 8px; background-color: ${bgColor}; display:flex; flex-direction: row; gap: 13px; align-items: center; justify-content: space-between;`}>
                  
                  <span class="rank-number" style="flex: 0.2; font-weight: bold;">{index + 1}</span>
                  
                  <div style="flex: 1; display: flex; flex-direction: row; align-items: center; gap: 8px;">
                    <span class={`pp-badge pp-badge-server pp-badge-server-${serverName}`} style="font-size: 10px; padding: 2px 5px; border-radius: 4px; flex-shrink: 0;">{serverName}</span>
                    <span style="font-weight: bold; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">{player?.nickname || 'Voyageur'}</span>
                  </div>
                  
                  <div style="flex: 0.5; display: flex; justify-content: center;">
                    {(() => {
                      let setIcon = null;
                      if (bestSetName && data.artefacts) {
                        const art = data.artefacts.find((a: any) => a.setKey === bestSetName && a.icon);
                        if (art) setIcon = art.icon;
                      }
                      if (bestSetName && setIcon) {
                        return <img src={`https://enka.network/ui/${setIcon}.png`} style="width: 36px; height: 36px; border-radius: 6px; background-color: rgba(0, 0, 0, 0.2); padding:2px;" alt={bestSetName} />;
                      } else if (bestSetName) {
                        return <span style="font-size: 12px; background: rgba(0,0,0,0.4); padding: 4px; border-radius: 4px; text-align: center;">{bestSetName.substring(0, 8)}.. ({bestSetCount}p)</span>;
                      } else {
                        return <span>-</span>;
                      }
                    })()}
                  </div>
                  
                  <div style="flex: 1; display: flex; flex-direction: row; align-items: center; justify-content: center; gap:8px;">
                    <div style="display: flex; flex-direction: row; align-items: center; opacity:0.5; font-size: 12px;">
                      <span>{(stats.critRate * 100).toFixed(1)}%</span>
                      <span> : {(stats.critDMG * 100).toFixed(1)}%</span>
                    </div>
                    <span style="font-size: 14px; color: var(--accent-gold);">{totalCV.toFixed(1)} CV</span>
                  </div>
                  
                  <div style="flex: 1; display:flex; flex-direction: row; align-items: center; justify-content: center; gap:6px;">
                    <img src="/assets/simulator/icons/icon_er.webp" style="width: 22px; height: 22px;" />
                    <span style="font-size: 14px;">{(stats.enerRech * 100).toFixed(1)}%</span>
                  </div>
                  
                  <div style="flex: 0.5; text-align: right;">
                    <span style={`font-size: 14px; font-weight: bold; color: ${evalData.grade?.color || 'var(--accent-gold)'}`}>
                      {build.score.toFixed(1)} ({evalData.grade?.letter || '?'})
                    </span>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      </div>
    </div>
    
    <script is:inline>
      function initErFilters() {
        const erButtons = document.querySelectorAll('.er-filter-btn');
        const rows = document.querySelectorAll('.leaderboard-list-row[data-er]');
        const defaultBtn = document.querySelector('.er-filter-btn');

        if (erButtons.length === 0 || rows.length === 0) return;

        function applyFilter(targetEr) {
          // Extraire tous les paliers disponibles et les trier du plus grand au plus petit
          const allBuckets = Array.from(erButtons)
            .map(b => parseInt(b.getAttribute('data-filter-er') || "100", 10))
            .sort((a, b) => b - a);

          let currentRank = 1;
          rows.forEach(row => {
            const rowEr = parseInt(row.getAttribute('data-er') || "100", 10);
            
            // Trouver le palier maximal que ce build peut atteindre
            let maxBucket = 100;
            for (const b of allBuckets) {
              if (rowEr >= b) {
                maxBucket = b;
                break;
              }
            }

            // Afficher uniquement si le build appartient à ce palier maximal
            if (maxBucket === targetEr) {
              row.style.display = 'flex';
              const rankSpan = row.querySelector('.rank-number');
              if (rankSpan) rankSpan.textContent = currentRank.toString();
              currentRank++;
            } else {
              row.style.display = 'none';
            }
          });
        }

        if (defaultBtn) {
          const defaultEr = parseInt(defaultBtn.getAttribute('data-filter-er') || "100", 10);
          applyFilter(defaultEr);
        }

        erButtons.forEach(btn => {
          btn.addEventListener('click', () => {
            // Reset all buttons
            erButtons.forEach(b => {
              b.style.background = 'rgba(0, 0, 0, 0.25)';
              b.style.borderColor = 'rgba(255,255,255,0)';
              const span = b.querySelector('span');
              if (span) span.style.color = 'var(--text-primary)';
            });
            
            // Set active state on clicked button
            btn.style.background = 'rgba(59,130,246,0.18)';
            btn.style.borderColor = '#3b82f6';
            const span = btn.querySelector('span');
            if (span) span.style.color = '#60a5fa';

            const targetEr = parseInt(btn.getAttribute('data-filter-er') || "100", 10);
            applyFilter(targetEr);
          });
        });
      }

      // Run on first load
      initErFilters();
      
      // Run on view transitions if enabled
      document.addEventListener('astro:page-load', initErFilters);
    </script>
  </StaticLayout>
</Layout>
