---
import Layout from "../../layouts/Layout.astro";
import StaticLayout from "../../layouts/StaticLayout.astro";
import { createClient } from '@supabase/supabase-js';

// Dictionnaire de traduction des noms de leaderboards
import leaderboardsNames from "../../data/leaderboards_names.json";
import { getCharConfigs, getEnkaAvatarMap, getEnkaImages, getFinalEnkaName, ELEMENT_COLORS, ENKA_ELEMENT_MAP, LOCAL_TO_ENKA_NAME, getCharNamesTranslations, getAssetTranslations } from "../../server/characters";
import teammateAssets from "../../data/teammate_assets.json";
// Désactiver le prerendering car on a besoin d'interroger Supabase en temps réel
export const prerender = false;

// Optimisation : Mise en cache CDN pour limiter les requêtes Supabase (économise la bande passante et les DB reads)
Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=300, stale-while-revalidate=600');

let pageError = "";
let characterList: any[] = [];
let totalLeaderboards = 0;
let totalEntries = 0;
let archetypeCounts: Record<string, number> = {};
let assetTranslations: any = {};

try {
  // 1. Initialisation de Supabase
  const supabaseUrl = import.meta.env.SUPABASE_URL || (Astro.locals as any)?.runtime?.env?.SUPABASE_URL;
  const supabaseKey = import.meta.env.SUPABASE_SERVICE_KEY || (Astro.locals as any)?.runtime?.env?.SUPABASE_SERVICE_KEY;
  if (!supabaseUrl) {
    const localKeys = Object.keys(Astro.locals || {}).join(', ');
    const envKeys = Object.keys((Astro.locals as any)?.runtime?.env || {}).join(', ');
    throw new Error(`DEBUG INFO: SUPABASE_URL is missing.\nlocals keys: [${localKeys}]\nruntime.env keys: [${envKeys}]`);
  }
  
  const supabase = createClient(supabaseUrl, supabaseKey);

  // 2. Chargement de toutes les configs de personnages
  const CHAR_CONFIGS = await getCharConfigs();
  const enkaAvatarMap = await getEnkaAvatarMap();
  assetTranslations = await getAssetTranslations(teammateAssets);

  // 3. Extraction des leaderboards par personnage
  for (const charName in CHAR_CONFIGS) {
    const config = CHAR_CONFIGS[charName];
    const color = config.color || "#5053bb";
    
    // Utilisation d'une Map pour dédoublonner les leaderboard_id
    const leaderboardsMap = new Map();

    for (const [buildName, buildData] of Object.entries(config.builds)) {
      const data = buildData as any;
      const lbId = data.leaderboard_id || buildName;
      
      if (!leaderboardsMap.has(lbId)) {
        leaderboardsMap.set(lbId, {
          id: lbId,
          teams: []
        });
        totalLeaderboards++;
      }
      
      // On sauvegarde toutes les variantes d'équipes pour ce leaderboard_id
      if (data.team) {
        leaderboardsMap.get(lbId).teams.push(data.team);
      }
    }

    // Si le personnage n'a aucun build configuré, on l'ignore (optionnel)
    if (leaderboardsMap.size === 0) continue;

    const finalEnkaName = getFinalEnkaName(charName);
    const { avatarImg: enkaAvatarImg, gachaImg: enkaGachaImg } = getEnkaImages(charName);

    let mainElem = 'physical';
    
    if (enkaAvatarMap[finalEnkaName] && enkaAvatarMap[finalEnkaName].Element) {
      const enkaElem = enkaAvatarMap[finalEnkaName].Element;
      mainElem = ENKA_ELEMENT_MAP[enkaElem] || enkaElem.toLowerCase();
    }

    const charTranslations = await getCharNamesTranslations(charName);

    characterList.push({
      name: charName.replace(/_/g, ' '),
      originalName: charName,
      translations: charTranslations,
      color: color,
      element: mainElem,
      avatarImg: enkaAvatarImg,
      gachaImg: enkaGachaImg,
      leaderboards: Array.from(leaderboardsMap.values()),
      isNew: config.isNew || false
    });
  }

  // Tri alphabétique des personnages (avec les "New" en premier)
  characterList.sort((a, b) => {
    if (a.isNew && !b.isNew) return -1;
    if (!a.isNew && b.isNew) return 1;
    return a.name.localeCompare(b.name);
  });

  // 4. Récupération des statistiques depuis Supabase
  const { data: buildsData, error } = await supabase.from('build_counts_by_archetype').select('*');

  if (buildsData && !error) {
    for (const b of buildsData) {
      const count = Number(b.count); // Conversion au cas où PostgreSQL renvoie un bigint(string)
      archetypeCounts[b.archetype] = count;
    }
  } else if (error) {
    console.error("Erreur lors de la récupération des statistiques:", error);
  }

  // 5. Calcul du vrai nombre d'entrées (max par personnage pour éviter les doublons)
  for (const char of characterList) {
    char.totalEntries = char.leaderboards.reduce((acc: number, lb: any) => Math.max(acc, (archetypeCounts[lb.id] || 0)), 0);
    totalEntries += char.totalEntries;
  }
} catch (e: any) {
  pageError = e.message || String(e);
}
---

{pageError ? (
  <div style="padding: 50px; background: #fff; color: #f00; font-family: sans-serif;">
    <h1 style="color: #f00;">Erreur Serveur (500)</h1>
    <p>Une erreur s'est produite lors du rendu côté serveur sur Cloudflare :</p>
    <pre style="background: #eee; padding: 15px; overflow-x: auto; color: #333;">{pageError}</pre>
    <p>Vérifiez que les variables d'environnement SUPABASE sont bien configurées dans Cloudflare, et que les APIs GitHub ne bloquent pas les requêtes (429).</p>
  </div>
) : (
<Layout title="Classements — guoba.gg" titleKey="nav.leaderboards" description="Découvrez guoba.gg, l'optimiseur de builds et coach virtuel indépendant pour Genshin Impact. Comprenez le fonctionnement des scores, grades et recommandations de farm.">
  <StaticLayout currentPage="leaderboards">
    <div class="static-page">
      <div class="static-page-hero">
        <h1 class="static-page-title" data-i18n="lb.title">Classements</h1>
        <p class="static-page-lead" data-i18n="lb.lead">Parcourez les classements basés sur le score et le grade.</p>
      </div>

      <div class="leaderboards-content" style="margin-top: 20px;">
        <div class="leaderboards-tools" style="display: flex; flex-direction: row; justify-content: space-between; flex-wrap: wrap; gap: 10px;">
          <div style="display: flex; gap: 8px; align-items: center; flex: 1;">
            <form id="searchForm" style="position: relative; width: 100%; max-width: 423px;">
              <input id="searchInput" data-i18n-placeholder="lb.search.placeholder" style="width: 100%; background: var(--bg-panel); border: none; border-radius: 8px; font-family: 'ShinShin', sans-serif; font-size: 14px; padding-left: 15px; padding-top: 17px; padding-bottom: 14px; color: var(--text-primary);" placeholder="Rechercher par nom de personnage..." />
              <button type="submit" style="position: absolute; right: 15px; top: 15px; background: none; border: none; cursor: pointer;">
                <img src="/assets/simulator/icons/icon_search_white.svg" alt="" style="width: 20px; height: 20px;" />
              </button>
            </form>
            
            <div class="custom-select-container" style="position: relative; flex-shrink: 0; z-index: 50;">
              <button id="sortDropdownBtn" type="button" style="justify-content: space-between; border:none; background: var(--bg-panel); color: var(--text-primary); padding: 0 15px; border-radius: 8px; cursor: pointer; font-family: inherit; font-size: 14px; outline: none; height: 100%; min-height: 50px; display: flex; align-items: center; width: 100%; min-width: 220px;">
                <span id="sort-current-label" class="dynamic-i18n" data-fr="Nom (A-Z)" data-en="Name (A-Z)">Nom (A-Z)</span>
                <img src="/assets/simulator/icons/icon_arrow_down_white.svg" alt="" style="width: 10px; height: 10px; opacity: 0.6; margin-left: 8px;">
              </button>

              <div id="sort-custom-menu" class="custom-select-menu" style="min-width: 100%; top: calc(100% + 5px); bottom: auto; margin-bottom: 0; right: 0; border: none;">
                <div class="custom-select-item" data-value="name-asc" data-fr="Nom (A-Z)" data-en="Name (A-Z)" style="background: var(--bg-active);">
                  <span class="dynamic-i18n" data-fr="Nom (A-Z)" data-en="Name (A-Z)">Nom (A-Z)</span>
                </div>
                <div class="custom-select-item" data-value="name-desc" data-fr="Nom (Z-A)" data-en="Name (Z-A)">
                  <span class="dynamic-i18n" data-fr="Nom (Z-A)" data-en="Name (Z-A)">Nom (Z-A)</span>
                </div>
                <div class="custom-select-item" data-value="entries-desc" data-fr="Entrées (Décroissant)" data-en="Entries (Descending)">
                  <span class="dynamic-i18n" data-fr="Entrées (Décroissant)" data-en="Entries (Descending)">Entrées (Décroissant)</span>
                </div>
                <div class="custom-select-item" data-value="entries-asc" data-fr="Entrées (Croissant)" data-en="Entries (Ascending)">
                  <span class="dynamic-i18n" data-fr="Entrées (Croissant)" data-en="Entries (Ascending)">Entrées (Croissant)</span>
                </div>
              </div>
            </div>
          </div>

          <div style="display: flex; color: var(--text-grey); font-size: 14px; align-items: center; gap: 5px;">
            <p><span class="dynamic-i18n-count-lb" data-count={totalLeaderboards}>{totalLeaderboards} classements</span> |</p>
            <p><span class="dynamic-i18n-count-entries" data-count={totalEntries}>{totalEntries} entrées</span></p>
          </div>
        </div>

        <div class="leaderboards-container" style="background: var(--bg-panel); border-radius: 8px; margin-top: 8px; padding: 5px;">
          <div class="leaderboards-head" style="display: flex; flex-direction: row; justify-content: space-between; margin: 7px 20px 10px 10px">
            <p style="font-size: 12px; flex: 1;" data-i18n="lb.rank">Classement</p>
            <p style="font-size: 12px; flex: 1; text-align: center;" data-i18n="lb.team">Équipe</p>
            <p style="font-size: 12px; flex: 1; text-align: right;" data-i18n="lb.entries">Entrées</p>
          </div>

          <div class="leaderboards-list-rows" id="leaderboardsList" style="display: flex; flex-direction: column; gap: 5px;">
            {characterList.map((char) => {
              const charTotalEntries = char.totalEntries || 0;
              return (
              <div class="character-group" data-char-name={char.name.toLowerCase()} data-entries={charTotalEntries} data-is-new={char.isNew ? "true" : "false"}>
                <!-- Ligne principale du Personnage -->
                <div class="leaderboard-list-row cursor-pointer" data-char={char.originalName} style={`position: relative; overflow: hidden; padding: 2px; padding-right: 20px; border-radius: 8px; background-color: var(--char-bg-alpha, rgb(from ${char.color} calc(r / 3.5) calc(g / 3.5) calc(b / 3.5) / 0.765)); display:flex; flex-direction: row; gap: 13px; align-items: center; cursor: pointer;`}>
                  <img src={char.gachaImg} loading="lazy" decoding="async" class="background-splash-art" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center center; z-index: 0; filter: blur(10px) brightness(0.7) saturate(0.8);" />
                  <div class="row-overlay" style={`position: absolute; inset: 0; background-color: var(--char-bg-alpha, rgb(from ${char.color} calc(r / 3.5) calc(g / 3.5) calc(b / 3.5) / 0.765)); transition: background-color 0.35s; z-index: 1;`}></div>

                  <img src={char.avatarImg} loading="lazy" decoding="async" onerror={`this.onerror=null; this.src='https://enka.network/ui/UI_AvatarIcon_${char.originalName.split('_')[0]}.png'`} style="z-index: 1; width: 52px; height: 52px; border-radius: 8px; background-color: rgba(0, 0, 0, 0.4);" />
                  
                  <div style="z-index: 1; display: flex; flex-direction: row; justify-content: space-between; align-items: center; width: 100%;">
                    <div style="display: flex; align-items: center; gap: 12px;">
                      <p style="font-size: 16px; margin: 0;" class="dynamic-i18n" data-fr={char.translations.fr} data-en={char.translations.en}>{char.name}</p>
                      {char.isNew && (
                        <div class="dynamic-i18n" data-fr="Nouveau !" data-en="New!" style="background: #3c5ccd; color: var(--text-always-white); font-family: 'ShinShin', sans-serif; font-size: 10px; padding: 2px 6px; border-radius: 4px;">Nouveau !</div>
                      )}
                    </div>
                    <div style="display: flex; flex-direction: row; justify-content: space-between; align-items: center; gap: 20px;">
                      <p style="font-size: 14px;"><span class="dynamic-i18n-count" data-count={char.leaderboards.length}>{char.leaderboards.length} classement{char.leaderboards.length > 1 ? 's' : ''}</span></p>
                      <img src="/assets/simulator/icons/icon_arrow_down_white.svg" alt="" class="sort-arrow" style="font-size: 12px; opacity: 0.6; flex-shrink: 0; transform: rotate(0deg); transition: transform 0.3s ease;" />
                    </div>
                  </div>
                </div>

                <!-- Conteneur déployable pour ses leaderboards -->
                <div class="leaderboards-details-wrapper" id={`details-${char.originalName}`}>
                  <div class="leaderboards-details-inner">
                  {char.leaderboards.map((lb: any, index: number) => {
                    const count = archetypeCounts[lb.id] || 0;
                    const lbNameObj = leaderboardsNames[lb.id as keyof typeof leaderboardsNames];
                    const lbName = lbNameObj ? lbNameObj.fr : lb.id;
                    const bgColor = index % 2 === 0 ? 'rgba(0, 0, 0, 0.2)' : 'var(--bg-panel)';
                    
                    // On prend la première team associée à ce leaderboard_id pour l'aperçu
                    const previewTeam = lb.teams.length > 0 ? lb.teams[0] : [];
                    
                    return (
                      <a href={`/leaderboards/${lb.id}`} data-astro-prefetch="hover" style="text-decoration: none; color: inherit; display: block;">
                        <div class="leaderboard-list-row-details hover-highlight" style={`position: relative; overflow: hidden; padding: 8px; padding-right: 20px; padding-left: 20px; border-radius: 8px; background-color: ${bgColor}; display:flex; flex-direction: row; gap: 20px; align-items: center; transition: background-color 0.2s ease;`}>
                          
                          <div style="z-index: 1; display: flex; flex-direction: row; justify-content: space-between; width: 100%; align-items: center;">
                            <p style="font-size: 14px; flex: 1;" class="dynamic-i18n" data-fr={lbNameObj ? lbNameObj.fr : lbName} data-en={lbNameObj ? lbNameObj.en : lbName}>{lbName}</p>
                            
                            <div class="leaderboard-list-row-details-team" style="display:flex; flex-direction: row; justify-content: center; gap:5px; flex: 1;">
                              {(() => {
                                const mainCharBg = ELEMENT_COLORS[char.element] || "#333";
                                const teamDisplay: any[] = [];
                                teamDisplay.push({
                                  isMain: true,
                                  iconUrl: char.avatarImg,
                                  bg: mainCharBg
                                });

                                for (let i = 0; i < 3; i++) {
                                  const ally = previewTeam[i];
                                  if (ally) {
                                    const rawName = Array.isArray(ally.name) ? (ally.name[0] || "") : (ally.name || "");
                                    const allyImgName = rawName ? rawName.replace(/ /g, '_') : "";
                                    const finalAllyEnkaName = getFinalEnkaName(allyImgName);
                                    
                                    const allyElem = Array.isArray(ally.element) ? ally.element[0] : ally.element;
                                    const bg = allyElem ? (ELEMENT_COLORS[allyElem.toLowerCase()] || "#333") : "#333";
                                    const weapon = ally.weapon || "";
                                    const set = ally.artifact ? ally.artifact.split(':')[0] : (ally.set ? ally.set.split(':')[0] : "");
                                    const cons = ally.cons !== undefined ? ally.cons : -1;
                                    
                                    let iconUrl = "";
                                    if (finalAllyEnkaName && !['Unknown', '?', ''].includes(finalAllyEnkaName)) {
                                      iconUrl = `https://enka.network/ui/UI_AvatarIcon_${finalAllyEnkaName}.png`;
                                    } else if (allyElem) {
                                      iconUrl = `/assets/simulator/icons/icon_${allyElem.toLowerCase()}.webp`;
                                    } else {
                                      iconUrl = `/assets/simulator/icons/icon_empty_slot.svg`;
                                    }
                                    
                                    teamDisplay.push({ isMain: false, iconUrl, bg, weapon, set, cons });
                                  } else {
                                    teamDisplay.push({ isMain: false, iconUrl: `/assets/simulator/icons/icon_empty_slot.svg`, bg: "rgba(0,0,0,0.4)" });
                                  }
                                }

                                return teamDisplay.map(member => (
                                  <div style="position: relative; width: 40px; height: 40px; flex-shrink: 0;">
                                    <img 
                                      loading="lazy" decoding="async"
                                      style={`width: 100%; height: 100%; border-radius: 5px; background: ${member.bg}; ${member.isMain ? 'border: 1px solid rgba(255, 255, 255, 0.4);' : ''}`} 
                                      src={member.iconUrl}
                                      onerror="this.onerror=null; this.style.display='none'"
                                    />
                                    {member.weapon && teammateAssets[member.weapon as keyof typeof teammateAssets] && (
                                      <img src={teammateAssets[member.weapon as keyof typeof teammateAssets]} loading="lazy" decoding="async" title={member.weapon} class="dynamic-i18n-title" data-fr={assetTranslations[member.weapon]?.fr || member.weapon} data-en={assetTranslations[member.weapon]?.en || member.weapon} style="position:absolute; bottom:0; left:0; width:14px; height:14px; border-radius:2px; z-index:10; background: var(--bg-panel);" onerror="this.style.display='none'" />
                                    )}
                                    {member.set && teammateAssets[member.set as keyof typeof teammateAssets] && (
                                      <img src={teammateAssets[member.set as keyof typeof teammateAssets]} loading="lazy" decoding="async" title={member.set} class="dynamic-i18n-title" data-fr={assetTranslations[member.set]?.fr || member.set} data-en={assetTranslations[member.set]?.en || member.set} style="position:absolute; bottom:0; right:0; width:14px; height:14px; border-radius:2px; z-index:10; background: var(--bg-panel);" onerror="this.style.display='none'" />
                                    )}
                                    {member.cons > 0 && (
                                      <span style="position:absolute; top:1px; right:2px; font-size:9px; font-weight:700; color:#fff; text-shadow:0 0 3px #000; z-index:10;">C{member.cons}</span>
                                    )}
                                  </div>
                                ));
                              })()}
                            </div>
                            
                            <p style="font-size: 14px; flex: 1; text-align: right;">{count}</p>
                          </div>
                        </div>
                      </a>
                    );
                  })}
                  </div>
                </div>
              </div>
              );
            })}
          </div>
        </div>
      </div>
    </div>
  </StaticLayout>
</Layout>
)}

<style>
  .hover-highlight:hover {
    background-color: rgba(255, 255, 255, 0.05) !important;
  }
  
  .leaderboards-details-wrapper {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition: grid-template-rows 0.35s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.25s cubic-bezier(0.4, 0, 0.2, 1), margin-top 0.35s cubic-bezier(0.4, 0, 0.2, 1), margin-bottom 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    margin-top: 0px;
    margin-bottom: 0px;
  }
  
  .leaderboards-details-wrapper.is-open {
    grid-template-rows: 1fr;
    opacity: 1;
    margin-top: 5px;
    margin-bottom: 5px;
  }
  
  .leaderboards-details-inner {
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
</style>

<script>
  function resolveTeammateIcons() {
    const resolveIconFromKey = (key) => {
        if (!key || !window['HASH_TO_KEY'] || !window['iconToNameHash']) return null;
        const hash = Object.keys(window['HASH_TO_KEY']).find(h => window['HASH_TO_KEY'][h] === key);
        if (!hash) return null;
        for (let [icon, h] of Object.entries(window['iconToNameHash'])) {
            if (String(h) === String(hash)) {
                let cleanIcon = (icon.split('/').pop() || '').replace('.png', '');
                if (cleanIcon.startsWith('UI_RelicIcon')) {
                    const base = cleanIcon.substring(0, cleanIcon.lastIndexOf('_'));
                    return `https://enka.network/ui/${base}_4.png`;
                } else {
                    return `https://enka.network/ui/${cleanIcon}.png`;
                }
            }
        }
        return null;
    };

    let allResolved = true;

    document.querySelectorAll<HTMLImageElement>('[data-weapon-icon]').forEach(img => {
        if (img.style.display === 'block') return; // already resolved
        const key = img.getAttribute('data-weapon-icon');
        const url = (window['ITEM_ICON_MAP'] && window['ITEM_ICON_MAP'][key]) || resolveIconFromKey(key);
        if (url) {
            img.src = url;
            img.style.display = 'block';
        } else {
            allResolved = false;
        }
    });

    document.querySelectorAll<HTMLImageElement>('[data-set-icon]').forEach(img => {
        if (img.style.display === 'block') return; // already resolved
        const key = img.getAttribute('data-set-icon');
        const url = (window['ITEM_ICON_MAP'] && window['ITEM_ICON_MAP'][key]) || resolveIconFromKey(key);
        if (url) {
            img.src = url;
            img.style.display = 'block';
        } else {
            allResolved = false;
        }
    });

    if (!allResolved) {
        window['_iconRetryCount'] = (window['_iconRetryCount'] || 0) + 1;
        if (window['_iconRetryCount'] < 20) {
            setTimeout(resolveTeammateIcons, 500);
        }
    }
  }

  function applyDynamicTranslations() {
      const w = window as any;
      const lang = w.GUOBA_LANG || (typeof localStorage !== 'undefined' ? localStorage.getItem('guoba_lang') : 'fr') || 'fr';
      const actualLang = ['fr', 'en'].includes(lang) ? lang : 'fr';
      
      document.querySelectorAll('.dynamic-i18n').forEach(el => {
          if (el.hasAttribute('data-' + actualLang)) {
              el.textContent = el.getAttribute('data-' + actualLang);
          }
      });
      document.querySelectorAll('.dynamic-i18n-title').forEach(el => {
          if (el.hasAttribute('data-' + actualLang)) {
              el.setAttribute('title', el.getAttribute('data-' + actualLang) || '');
          }
      });

      if (w.t) {
        document.querySelectorAll('.dynamic-i18n-count').forEach(el => {
            const count = parseInt(el.getAttribute('data-count') || '0', 10);
            el.textContent = w.t('lb.count', count);
        });
        document.querySelectorAll('.dynamic-i18n-count-entries').forEach(el => {
            const count = parseInt(el.getAttribute('data-count') || '0', 10);
            el.textContent = w.t('lb.entriesCount', count);
        });
        document.querySelectorAll('.dynamic-i18n-count-lb').forEach(el => {
            const count = parseInt(el.getAttribute('data-count') || '0', 10);
            el.textContent = w.t('lb.count', count);
        });
      }
  }

  function setupLeaderboardsList() {
    window['_iconRetryCount'] = 0;
    resolveTeammateIcons();
    applyDynamicTranslations();
    
    // Logique de déploiement des lignes (Accordéon)
    document.querySelectorAll('.leaderboard-list-row').forEach(row => {
      // Pour éviter d'ajouter plusieurs fois le même event listener, on le retire d'abord (ou on clone le noeud, mais cloner perdrait d'autres events).
      // Le plus simple avec astro:page-load est que les éléments du DOM sont récréés, mais c'est bien de s'assurer de ne pas s'abonner en double si ce n'est pas le cas.
      row.removeEventListener('click', toggleRow);
      row.addEventListener('click', toggleRow);
    });

    function toggleRow(e: Event) {
      const row = e.currentTarget as HTMLElement;
      const charId = row.getAttribute('data-char');
      const details = document.getElementById(`details-${charId}`) as HTMLElement | null;
      const arrow = row.querySelector('.sort-arrow') as HTMLElement | null;
      
      if (details) {
        if (!details.classList.contains('is-open')) {
          details.classList.add('is-open');
          if (arrow) arrow.style.transform = 'rotate(180deg)';
        } else {
          details.classList.remove('is-open');
          if (arrow) arrow.style.transform = 'rotate(0deg)';
        }
      }
    }

    // Logique de recherche simple
    function searchCharacter() {
      const input = document.getElementById('searchInput') as HTMLInputElement | null;
      if(!input) return;
      const filter = input.value.toLowerCase();
      
      document.querySelectorAll('.character-group').forEach((group) => {
        const htmlGroup = group as HTMLElement;
        const charName = htmlGroup.getAttribute('data-char-name');
        if (charName && charName.includes(filter)) {
          htmlGroup.style.display = 'block';
        } else {
          htmlGroup.style.display = 'none';
        }
      });
    }

    const searchForm = document.getElementById('searchForm');
    if (searchForm) {
      searchForm.addEventListener('submit', (e) => {
        e.preventDefault();
        searchCharacter();
      });
    }
    
    const searchInput = document.getElementById('searchInput');
    if (searchInput) {
      searchInput.addEventListener('input', searchCharacter);
    }

    // Logique de tri (Custom Dropdown)
    const sortDropdownBtn = document.getElementById('sortDropdownBtn');
    const sortCustomMenu = document.getElementById('sort-custom-menu');
    
    if (sortDropdownBtn && sortCustomMenu) {
      sortDropdownBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        sortCustomMenu.classList.toggle('show');
      });
      
      document.addEventListener('click', () => {
        sortCustomMenu.classList.remove('show');
      });

      document.querySelectorAll('#sort-custom-menu .custom-select-item').forEach(item => {
        item.addEventListener('click', (e) => {
          const val = item.getAttribute('data-value');
          const frLabel = item.getAttribute('data-fr');
          const enLabel = item.getAttribute('data-en');
          
          const labelEl = document.getElementById('sort-current-label');
          if (labelEl) {
            labelEl.setAttribute('data-fr', frLabel || '');
            labelEl.setAttribute('data-en', enLabel || '');
            const w = window as any;
            const lang = w.GUOBA_LANG || (typeof localStorage !== 'undefined' ? localStorage.getItem('guoba_lang') : 'fr') || 'fr';
            labelEl.textContent = (lang === 'en' ? enLabel : frLabel) || '';
          }
          
          document.querySelectorAll('#sort-custom-menu .custom-select-item').forEach(el => el.setAttribute('style', ''));
          item.setAttribute('style', 'background: var(--bg-active);');
          
          sortCustomMenu.classList.remove('show');
          
          const list = document.getElementById('leaderboardsList');
          if (!list) return;
          
          const groups = Array.from(list.querySelectorAll('.character-group')) as HTMLElement[];
          
          groups.sort((a, b) => {
            const aIsNew = a.getAttribute('data-is-new') === 'true';
            const bIsNew = b.getAttribute('data-is-new') === 'true';
            
            if (val === 'name-asc') {
              if (aIsNew && !bIsNew) return -1;
              if (!aIsNew && bIsNew) return 1;
              return (a.getAttribute('data-char-name') || '').localeCompare(b.getAttribute('data-char-name') || '');
            } else if (val === 'name-desc') {
              if (aIsNew && !bIsNew) return -1;
              if (!aIsNew && bIsNew) return 1;
              return (b.getAttribute('data-char-name') || '').localeCompare(a.getAttribute('data-char-name') || '');
            } else if (val === 'entries-desc') {
              const ea = parseInt(a.getAttribute('data-entries') || '0', 10);
              const eb = parseInt(b.getAttribute('data-entries') || '0', 10);
              return eb - ea;
            } else if (val === 'entries-asc') {
              const ea = parseInt(a.getAttribute('data-entries') || '0', 10);
              const eb = parseInt(b.getAttribute('data-entries') || '0', 10);
              return ea - eb;
            }
            return 0;
          });
          
          groups.forEach(g => list.appendChild(g));
        });
      });
    }
  }

  // Initialisation lors des navigations Astro (View Transitions)
  document.addEventListener('astro:page-load', setupLeaderboardsList);
</script>
