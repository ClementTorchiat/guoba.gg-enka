---
// src/pages/about.astro
import Layout from "../layouts/Layout.astro";
import StaticLayout from "../layouts/StaticLayout.astro";

const aboutSchema = [
  {
    "@context": "https://schema.org",
    "@type": "AboutPage",
    name: "À propos de guoba.gg",
    url: "https://guoba.clement-torchiat.fr/about",
    description:
      "Optimiseur de builds et coach virtuel Genshin Impact indépendant, conçu par des joueurs pour des joueurs.",
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [
      {
        "@type": "Question",
        name: "Qu'est-ce que guoba.gg ?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "guoba.gg est un outil d'analyse de builds et de statistiques pour Genshin Impact. En entrant votre UID, l'outil évalue la qualité mathématique de vos équipements via un double système de score et de grade, simule vos statistiques réelles en combat sous buffs, et vous guide pas à pas pour perfectionner votre personnage.",
        },
      },
      {
        "@type": "Question",
        name: "Comment fonctionne guoba.gg ?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Vos données publiques sont récupérées de façon transparente via l'API Enka.Network à partir de votre UID, sans aucun mot de passe. Chaque artéfact est évalué selon les tables de rolls officielles du jeu et pondéré selon les besoins de votre personnage.",
        },
      },
      {
        "@type": "Question",
        name: "Ce que guoba.gg n'est pas",
        acceptedAnswer: {
          "@type": "Answer",
          text: "guoba.gg n'est pas un outil officiel de HoYoverse, ni un simulateur de dégâts speedrun ou une tier list. Il se concentre sur la qualité mathématique de votre investissement et l'orientation de votre farm.",
        },
      },
    ],
  },
];
---

<Layout
  title="À propos — guoba.gg"
  titleKey="nav.about"
  description="Découvrez guoba.gg, l'optimiseur de builds et coach virtuel indépendant pour Genshin Impact. Comprenez le fonctionnement des scores, grades et recommandations de farm."
  schema={aboutSchema}
>
  <StaticLayout currentPage="about">
    <div class="static-page">
      <div class="static-page-hero">
        <h1 class="static-page-title" data-i18n="page.about.title">guoba.gg</h1>
        <p class="static-page-lead" data-i18n="page.about.lead">
          Un optimiseur de builds Genshin Impact indépendant, conçu par des
          joueurs, pour des joueurs.
        </p>
      </div>

      <div class="static-page-body">
        <section class="static-section">
          <h2 class="static-section-title" data-i18n="page.about.q1.title">
            Qu'est-ce que guoba.gg ?
          </h2>
          <p data-i18n-html="page.about.q1.p1">
            <strong>guoba.gg</strong> réinvente l'optimisation sur Genshin Impact.
            Bien plus qu'une simple calculatrice, c'est un véritable <strong
              >coach virtuel</strong
            > : en entrant votre UID, l'outil évalue la qualité mathématique pure
            de vos équipements via un double système de score et de grade, simule
            vos statistiques réelles en combat sous buffs, et vous guide pas à pas
            pour perfectionner votre personnage.
          </p>
          <p class="static-note" data-i18n="page.about.q1.p2">
            Le projet est né d'une frustration simple : le besoin d'avoir un
            outil précis, immersif et proactif pour orienter ses choix de farm
            sans avoir à ouvrir un tableur.
          </p>
        </section>

        <div class="static-divider"></div>

        <section class="static-section">
          <h2 class="static-section-title" data-i18n="page.about.q2.title">
            Comment ça fonctionne ?
          </h2>
          <div class="static-cards">
            <div class="static-card">
              <strong data-i18n="page.about.q2.c1.title">Récupération</strong>
              <p data-i18n-html="page.about.q2.c1.desc">
                Vos données sont lues via l'API publique d'<a
                  href="https://enka.network"
                  target="_blank"
                  rel="noopener">Enka.Network</a
                > à partir de votre UID. Aucun compte, aucun mot de passe, et vos
                données sont en local.
              </p>
            </div>
            <div class="static-card">
              <strong data-i18n="page.about.q2.c2.title">Calcul</strong>
              <p data-i18n-html="page.about.q2.c2.desc">
                Chaque artéfact est évalué selon les tables de rolls officielles
                du jeu, pondéré par les besoins de votre personnage et ajusté
                selon vos bonus de set.
              </p>
            </div>
            <div class="static-card">
              <strong data-i18n="page.about.q2.c3.title">Coaching visuel</strong
              >
              <p data-i18n-html="page.about.q2.c3.desc">
                Les résultats s'affichent sous forme de fiches immersives avec
                des grades, des graphiques et des recommandations d'actions
                immédiates.
              </p>
            </div>
            <div class="static-card">
              <strong data-i18n="page.about.q2.c4.title"
                >Partage & Export</strong
              >
              <p data-i18n-html="page.about.q2.c4.desc">
                Générez une fiche visuelle de votre personnage en un clic, ou
                partagez directement le lien de votre profil avec la communauté
                pour comparer vos builds.
              </p>
            </div>
          </div>
        </section>

        <div class="static-divider"></div>

        <section class="static-section">
          <h2 class="static-section-title" data-i18n="page.about.q3.title">
            Ce que guoba.gg n'est pas
          </h2>
          <ul class="static-list">
            <li data-i18n-html="page.about.q3.l1">
              Ce n'est <strong>pas</strong> un outil officiel de HoYoverse.
            </li>
            <li data-i18n-html="page.about.q3.l2">
              Ce n'est <strong>pas</strong> un simulateur de dégâts ou un classement
              de speedrun.
            </li>
            <li data-i18n-html="page.about.q3.l3">
              Ce n'est <strong>pas</strong> une base de données de tier lists.
            </li>
          </ul>
          <p class="static-note" data-i18n-html="page.about.q3.note">
            L'outil se concentre sur la <strong
              >qualité de votre investissement</strong
            > : vos artéfacts sont-ils mathématiquement excellents, votre build est-il
            bien équilibré en jeu, et que devez-vous farmer en priorité absolue ?
          </p>
        </section>

        <div class="static-divider"></div>

        <section class="static-section">
          <h2 class="static-section-title" data-i18n="page.about.q4.title">
            Open source & contributions
          </h2>
          <p data-i18n="page.about.q4.desc">
            Le projet est ouvert aux retours de la communauté. Si vous repérez
            une erreur dans les poids d'un personnage, une stat mal calculée ou
            souhaitez proposer une amélioration, rejoignez le Discord.
          </p>
          <div class="static-links">
            <a
              class="link-button"
              href="https://discord.gg/CZ5qxVqBVJ"
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="currentColor"
                style="margin-right: 6px;"
                ><path
                  d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.893.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"
                ></path></svg
              >Discord
            </a>
            <a
              class="link-button-coffee"
              href="https://ko-fi.com/guobagg"
              target="_blank"
              rel="noopener noreferrer"
            >
              <img
                src="https://cdn.prod.website-files.com/5c14e387dab576fe667689cf/670f5a01229bf8a18f97a3c1_favion.png"
                alt=""
                width="18"
                height="18"
              />
              Buy me a coffee
            </a>
          </div>
        </section>
      </div>
    </div>
  </StaticLayout>
</Layout>
