---
import Sidebar from "../components/Sidebar.astro";
// src/pages/index.astro
import Layout from "../layouts/Layout.astro";
import HalloweenDecorations from "../components/HalloweenDecorations.astro";
import ChristmasDecorations from "../components/ChristmasDecorations.astro";
import LanternRiteDecorations from "../components/LanternRiteDecorations.astro";
import EasterDecorations from "../components/EasterDecorations.astro";
import AnniversaryDecorations from "../components/AnniversaryDecorations.astro";
import { Image, getImage } from "astro:assets";
import guobaLogo from "../assets/global/favicon.png";

import step1Img from "../assets/onboarding/step1.webp";
import step2Img from "../assets/onboarding/step2.png";
import step3Img from "../assets/onboarding/step3.png";
import step4Img from "../assets/onboarding/step4.png";
import step5Img from "../assets/onboarding/step5.png";

const optStep2 = await getImage({
    src: step2Img,
    format: "webp",
    width: 608,
    quality: 80,
});
const optStep3 = await getImage({
    src: step3Img,
    format: "webp",
    width: 900,
    quality: 80,
});
const optStep4 = await getImage({
    src: step4Img,
    format: "webp",
    width: 500,
    quality: 80,
});
const optStep5 = await getImage({
    src: step5Img,
    format: "webp",
    width: 900,
    quality: 80,
});

const onboardingImages = {
    step1: step1Img.src,
    step2: optStep2.src,
    step3: optStep3.src,
    step4: optStep4.src,
    step5: optStep5.src,
};
---

<Layout titleKey="page.title.default">
    <HalloweenDecorations />
    <!-- <ChristmasDecorations /> -->
    <!-- <LanternRiteDecorations /> -->
    <!-- <EasterDecorations /> -->
    <!-- <AnniversaryDecorations /> -->
    <script is:inline define:vars={{ onboardingImages }}>
        window.OB_OPTIMIZED_IMAGES = onboardingImages;
    </script>
    <div id="mobile-block-overlay">
        <div class="mobile-block-content">
            <h2 style="margin: 0 0 10px 0;" data-i18n="mobile.title"></h2>
            <p style="color: #a0a5b1; margin-bottom: 20px;" data-i18n="mobile.body"></p>
            <p style="font-weight: bold; color: var(--text-primary);" data-i18n="mobile.wip"></p>
            <p style="font-weight: bold; color: var(--text-primary); margin-top: 24px;" data-i18n="mobile.hint"></p>
        </div>
    </div>
    <main>
        <div class="layout-flex">
            <div class="layout-content">
                <Sidebar currentPage="home" />
                <div class="main-content">
                    <div id="player-profile"></div>
                    <div class="main-content-menu" style="display: none; justify-content: space-between; align-items: flex-end; gap: 8px;">
                        <div class="main-content-menu-container">
                            <div id="toolbar-controls" style="display: flex; align-items: center; gap: 8px; flex: 1;"></div>
                            <div class="menu-actions" style="display:flex; gap:10px;"></div>
                        </div>

                        <a id="leaderboard-link" href="/leaderboards" class="leaderboards-container" style="display: flex; justify-content: space-between; padding-left: 15px; padding-right: 16px; align-items: center; width: 100%; height: 50px; background: var(--bg-panel); color: var(--text-primary);border: none;border-radius: 8px; text-decoration: none; cursor: pointer; transition: background 0.2s ease;">
                            <div class="leaderboards-left" style="display: flex; align-items: center;">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 469.11 402.49" width="20" height="19" fill="var(--text-always-white)" aria-hidden="true" style="margin-bottom: 2px;">
                                    <path d="M313.04,77.24c-9.19-2.82-16.78-4.99-23.47-6.91-17.32-4.95-26.01-7.44-30.94-12.37-4.93-4.93-7.42-13.62-12.38-30.95-1.92-6.69-4.09-14.28-6.92-23.48C238.69,1.43,236.75,0,234.55,0s-4.13,1.43-4.78,3.53c-2.82,9.2-4.99,16.78-6.91,23.48-4.95,17.33-7.44,26.02-12.37,30.95-4.93,4.93-13.62,7.41-30.95,12.37-6.69,1.91-14.28,4.08-23.48,6.91-2.1,.64-3.53,2.58-3.53,4.78s1.43,4.14,3.53,4.78c9.2,2.83,16.78,5,23.48,6.92,17.33,4.96,26.02,7.45,30.95,12.38,4.93,4.93,7.41,13.62,12.37,30.94,1.91,6.69,4.08,14.28,6.91,23.47,.65,2.1,2.58,3.53,4.78,3.53h0c2.19,0,4.13-1.43,4.78-3.53,2.83-9.19,5-16.78,6.92-23.47,4.96-17.32,7.45-26.01,12.38-30.94s13.62-7.42,30.94-12.38c6.69-1.92,14.28-4.09,23.47-6.92,2.1-.65,3.53-2.58,3.53-4.78s-1.43-4.13-3.53-4.78Z"></path>
                                    <g>
                                        <path d="M130.16,309.05v-48.67c0-7.98-6.47-14.45-14.45-14.45H14.51c-7.98,0-14.45,6.47-14.45,14.45v40.73c0,2.18,0,4.37,0,6.55v21.82c-.03,9.41-.1,18.82,0,28.23v30.23c0,7.98,6.47,14.45,14.45,14.45H53.55c7.58,.13,15.16,.13,22.73,0h39.42c7.98,0,14.45-6.47,14.45-14.45v-48.7c.07-10.06,.07-20.13,0-30.19Z"></path>
                                        <path d="M469.03,345.63v-33.14c0-7.98-6.47-14.45-14.45-14.45h-101.2c-7.98,0-14.45,6.47-14.45,14.45v23.63c-.03,.61-.05,1.22-.05,1.83-.03,8.25-.1,16.51,.02,24.76,0,.28,.02,.55,.03,.83v24.4c0,7.98,6.47,14.45,14.45,14.45h101.2c7.98,0,14.45-6.47,14.45-14.45v-31.75c.12-3.51,.12-7.04,0-10.55Z"></path>
                                        <path d="M285.14,193.8h-101.2c-7.98,0-14.45,6.47-14.45,14.45v24.8c0,.17-.01,.33-.01,.5-.05,21.28-.01,42.57,0,63.85,0,16.45-.1,32.91-.05,49.36,.01,3.59,.04,7.19,.07,10.78v30.29c0,7.98,6.47,14.45,14.45,14.45h33.68c11.11,.27,22.23,.27,33.34,0h34.18c7.98,0,14.45-6.47,14.45-14.45V208.25c0-7.98-6.47-14.45-14.45-14.45Z"></path>
                                    </g>
                                </svg>
                                <div class="leaderboards-placeholder" style="font-size: 14px; margin-left: 12px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 150px;">
                                    <span style="opacity: 0.5;">...</span>
                                </div>
                            </div>
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0;"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                        </a>

                        <div style="display: flex; flex-direction: row; align-items: center; gap: 8px; max-width: 240px; width: 100%; min-width: 240px;">
                            <button onclick="openOnboarding()" data-i18n-title="ui.helpBtn" data-i18n-aria-label="ui.helpBtn" style="
                            background: var(--bg-panel);
                            border: none;
                            border-radius: 8px;
                            color: var(--text-primary);
                            display: flex;
                            align-items: center;
                            justify-content: center;
                            width: 50px;
                            height: 50px;
                            cursor: pointer;
                            flex-shrink: 0;
                            ">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 114.79 169.26" width="10px" fill="var(--text-always-white)" aria-hidden="true">
                                    <path d="M113.71,36.26c-2.52-12.66-9.66-21.76-20.98-27.62C81,2.55,68.21,.91,55.87,0,34.31,.39,17.41,8.48,5.63,26.12,2.66,30.57-.58,35.11,.09,40.98c.69,6.01,6.34,9.31,11.56,6.35,3.38-1.91,6.7-4.35,9.22-7.26,8.89-10.28,19.61-15.64,33.44-14.26,8.75,.88,17.01,7.47,18.34,15.03,1.56,8.9-2.79,16.06-12.47,19.89-4.27,1.69-8.82,2.66-13.17,4.18-8.27,2.89-13.74,8.23-15.74,17.15-3.37,15.03,1.76,27.47,10.99,38.79,2.59,3.17,6.17,4.66,10.24,3.81,4.04-.84,6.13-4.02,7.29-7.66,1.07-3.38,1.71-6.9,2.47-10.38,2.29-10.42,6.53-14.43,17.11-16.36,14.16-2.58,25.66-9.03,31.36-22.98,4.07-9.96,5.11-20.35,2.98-31.03Z"></path>
                                    <path d="M50.92,128.07c-12.29,.1-20.71,8.51-20.66,20.63,.05,12.19,8.44,20.48,20.79,20.55,12.19,.07,20.55-8.36,20.52-20.67-.04-12.37-8.33-20.62-20.65-20.52Z"></path>
                                </svg>
                            </button>
                            <button onclick="exportBuildAsImage()" class="main-content-menu-export" style="background: var(--bg-panel);color: var(--text-primary);border: none;border-radius: 8px;height: 50px;cursor: pointer;display: flex;align-items: center;justify-content: center;gap: 12px;flex-grow: 1;min-width: 0;">
                                <svg width="14px" fill="var(--text-always-white)" aria-hidden="true" viewBox="0 0 179 197" xmlns="http://www.w3.org/2000/svg" style="margin-bottom: 2px">
                                    <g clip-path="url(#clip0_976_726)">
                                        <path d="M178.41 72.16L163.84 72.13C163.447 72.13 163.125 72.5801 163.125 73.1303V141.13C163.125 141.68 163.447 142.13 163.84 142.13H178.388C178.782 142.13 179.104 141.68 179.104 141.13L179.125 73.1503C179.125 72.6001 178.803 72.16 178.417 72.15L178.41 72.16Z"></path>
                                        <path d="M15.4098 72.16L0.840244 72.13C0.44686 72.13 0.125 72.5801 0.125 73.1303V141.13C0.125 141.68 0.44686 142.13 0.840244 142.13H15.3883C15.7817 142.13 16.1035 141.68 16.1035 141.13L16.125 73.1503C16.125 72.6001 15.8031 72.16 15.4169 72.15L15.4098 72.16Z"></path>
                                        <path d="M36.1716 29.8284L45.8284 20.1716C46.5786 19.4214 47.596 19 48.6569 19H131.343C132.404 19 133.421 19.4214 134.172 20.1716L143.828 29.8284C144.579 30.5786 145 31.596 145 32.6569V45C145 45.5523 145.448 46 146 46H165C165.552 46 166 45.5523 166 45V25.5029C166 24.534 165.648 23.5981 165.01 22.8689L146.195 1.36598C145.436 0.497921 144.338 0 143.185 0H36.8151C35.6616 0 34.5643 0.497921 33.8048 1.36598L14.9897 22.8689C14.3517 23.5981 14 24.534 14 25.5029V45C14 45.5523 14.4477 46 15 46H34C34.5523 46 35 45.5523 35 45V32.6569C35 31.596 35.4214 30.5786 36.1716 29.8284Z"></path>
                                        <path
                                            fill-rule="evenodd"
                                            clip-rule="evenodd"
                                            d="M132.135 25.9503C132.415 25.9503 132.685 26.0704 132.875 26.2804L139.465 33.7599L139.625 34.2501L139.885 51.0197C139.895 51.8997 140.615 52.6095 141.495 52.6095H154.935V52.5997C155.484 52.5997 155.934 53.0498 155.935 53.5997V196.22C155.935 196.34 155.915 196.46 155.885 196.57C155.854 196.92 155.485 197.26 155.035 197.26H24.4746C24.2246 197.26 23.9942 197.16 23.8242 196.97C23.7242 196.85 23.5547 196.6 23.5547 196.22V53.6095C23.5549 53.0597 24.0048 52.6095 24.5547 52.6095H42.0146V34.2999C42.0147 34.04 42.1245 33.7799 42.3145 33.59L49.835 26.2198C50.0249 26.04 50.2752 25.9503 50.5352 25.9503H132.135ZM90.4346 97.1798C81.4946 97.1798 73.5644 100.92 68.0244 106.46C57.9746 116.51 53.8345 134.47 67.2344 151.95L67.2451 151.96C84.715 165.35 102.675 161.21 112.725 151.17C120.57 143.325 124.814 130.66 119.924 117.165C116.939 108.925 110.27 102.256 102.03 99.2688C98.0583 97.8288 94.1588 97.1798 90.4346 97.1798ZM107.473 68.2607C107.117 59.4368 99.3524 51.6646 90.529 51.2965C85.2066 51.0745 80.4615 53.2233 77.2051 56.4796H77.1943C71.5643 62.1096 69.2451 72.1801 76.7451 82.0001L76.7646 82.0197C86.5846 89.5196 96.6552 87.2004 102.285 81.5704C105.539 78.3166 107.687 73.5763 107.473 68.2607Z"
                                        ></path>
                                    </g>
                                    <defs>
                                        <clipPath id="clip0_976_726">
                                            <rect width="179" height="197" fill="var(--text-always-white)"></rect>
                                        </clipPath>
                                    </defs>
                                </svg>
                                <span style="white-space: nowrap;" data-i18n="ui.exportBtn"></span>
                            </button>
                        </div>
                    </div>
                    <div class="main-content-showcase" id="main-container"></div>
                </div>
            </div>
        </div>
    </main>
    <div id="onboardingModal" class="ob-overlay">
        <div class="ob-card">
            <button class="ob-close-btn" onclick="closeOnboarding()" data-i18n-title="ob.close" data-i18n-aria-label="ob.close">
                <svg xmlns="http://www.w3.org/2000/svg" width="24px" fill="var(--text-always-white)" viewBox="0 0 640 640"><path d="M183.1 137.4C170.6 124.9 150.3 124.9 137.8 137.4C125.3 149.9 125.3 170.2 137.8 182.7L275.2 320L137.9 457.4C125.4 469.9 125.4 490.2 137.9 502.7C150.4 515.2 170.7 515.2 183.2 502.7L320.5 365.3L457.9 502.6C470.4 515.1 490.7 515.1 503.2 502.6C515.7 490.1 515.7 469.8 503.2 457.3L365.8 320L503.1 182.6C515.6 170.1 515.6 149.8 503.1 137.3C490.6 124.8 470.3 124.8 457.8 137.3L320.5 274.7L183.1 137.4z"></path></svg>
            </button>
            <div class="ob-progress-bar">
                <div class="ob-progress-fill" id="ob-progress-fill" style="width:20%"></div>
            </div>
            <div class="ob-header">
                <div class="ob-logo-row">
                    <Image src={guobaLogo} alt="guoba" class="ob-logo-img" width={28} height={28} />
                    <span class="ob-logo-text">guoba.gg</span>
                </div>
                <span class="ob-step-label" id="ob-step-label"></span>
            </div>
            <div class="ob-body" id="ob-body"></div>
            <div class="ob-footer">
                <div class="ob-dots" id="ob-dots"></div>
                <div class="ob-nav-btns">
                    <button class="ob-btn ob-btn-prev" id="ob-prev-btn" onclick="obPrev()" disabled>
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 122.62 196.95" width="11" height="13" fill="var(--text-muted)" aria-hidden="true">
                            <rect x="66.6" y="76.69" width="43.58" height="43.58" rx=".5" ry=".5" transform="translate(-43.75 91.35) rotate(-45)"></rect>
                            <path d="M98.81,.15l23.66,23.66c.2,.2,.2,.52,0,.72l-24.07,24.07-49.52,49.52c-.2,.2-.2,.52,0,.72l49.52,49.52,24.07,24.07c.2,.2,.2,.52,0,.72l-23.65,23.65c-.22,.22-.59,.19-.77-.06-12.22-17.14-28.08-36.67-48.36-56.48C32.39,123.36,15.44,109.74,.21,98.88c-.28-.2-.28-.6,0-.81,15.74-11.75,33.05-26.17,50.74-43.69C70.05,35.46,85.58,16.91,98.04,.2c.18-.25,.54-.27,.76-.05h0Z"></path>
                        </svg>
                        <span data-i18n="ob.prev"></span>
                    </button>
                    <button class="ob-btn ob-btn-next" id="ob-next-btn" onclick="obNext()">
                        <span data-i18n="ob.next"></span>
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 122.62 196.95" width="11" height="13" fill="#0b0f19" aria-hidden="true">
                            <g transform="translate(122.62, 0) scale(-1, 1)">
                                <rect x="66.6" y="76.69" width="43.58" height="43.58" rx=".5" ry=".5" transform="translate(-43.75 91.35) rotate(-45)"></rect>
                                <path d="M98.81,.15l23.66,23.66c.2,.2,.2,.52,0,.72l-24.07,24.07-49.52,49.52c-.2,.2-.2,.52,0,.72l49.52,49.52,24.07,24.07c.2,.2,.2,.52,0,.72l-23.65,23.65c-.22,.22-.59,.19-.77-.06-12.22-17.14-28.08-36.67-48.36-56.48C32.39,123.36,15.44,109.74,.21,98.88c-.28-.2-.28-.6,0-.81,15.74-11.75,33.05-26.17,50.74-43.69C70.05,35.46,85.58,16.91,98.04,.2c.18-.25,.54-.27,.76-.05h0Z"></path>
                            </g>
                        </svg>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script>
        import "../scripts/app.js";
    </script>
</Layout>
