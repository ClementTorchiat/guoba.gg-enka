                                    </svg>
                                </span>
                                <div class="roadmap-btn-texts">
                                    <span
                                        class="roadmap-btn-title"
                                        data-i18n="roadmap.button.title"
                                        >Roadmap du compte</span
                                    >
                                    <span
                                        class="roadmap-btn-sub"
                                        data-i18n="roadmap.button.subtitle"
                                        >Stratégie & Optimisation</span
                                    >
                                </div>
                            </div>
                            <img
                                src="assets/simulator/icons/icon_arrow_down_white.svg"
                                alt=""
                                class="roadmap-btn-arrow"
                                style="width: 10px; height: 10px; transform: rotate(-90deg); opacity: 0.6; margin-right: 14px; flex-shrink: 0;"
                            />
                        </button>
