---
// src/pages/index.astro
import Layout from "../layouts/Layout.astro";
import { Image, getImage } from "astro:assets";
import guobaLogo from "../assets/global/favicon.png";

import step1Img from "../assets/onboarding/step1.gif";
import step2Img from "../assets/onboarding/step2.png";
import step3Img from "../assets/onboarding/step3.png";
import step4Img from "../assets/onboarding/step4.png";
import step5Img from "../assets/onboarding/step5.png";

const optStep2 = await getImage({
    src: step2Img,
    format: "webp",
    width: 608,
    quality: 80,
});
const optStep3 = await getImage({
    src: step3Img,
    format: "webp",
    width: 900,
    quality: 80,
});
const optStep4 = await getImage({
    src: step4Img,
    format: "webp",
    width: 500,
    quality: 80,
});
const optStep5 = await getImage({
    src: step5Img,
    format: "webp",
    width: 900,
    quality: 80,
});

const onboardingImages = {
    step1: step1Img.src,
    step2: optStep2.src,
    step3: optStep3.src,
    step4: optStep4.src,
    step5: optStep5.src,
};
---

<Layout titleKey="page.title.default">
    <script is:inline define:vars={{ onboardingImages }}>
        window.OB_OPTIMIZED_IMAGES = onboardingImages;
    </script>
    <div id="mobile-block-overlay">
        <div class="mobile-block-content">
            <h2 style="margin: 0 0 10px 0;" data-i18n="mobile.title"></h2>
            <p
                style="color: #a0a5b1; margin-bottom: 20px;"
                data-i18n="mobile.body"
            >
            </p>
            <p
                style="font-weight: bold; color: var(--text-primary);"
                data-i18n="mobile.wip"
            >
            </p>
            <p
                style="font-weight: bold; color: var(--text-primary); margin-top: 24px;"
                data-i18n="mobile.hint"
            >
            </p>
        </div>
    </div>
    <main>
        <div class="layout-flex">
            <div class="layout-content">
                <aside class="sidebar">
                    <div class="sidebar-title">
                        <div
                            class="sidebar-title-container"
                            onclick="clearSearch()"
                            style="cursor: pointer;"
                        >
                            <Image
                                src={guobaLogo}
                                alt="guoba"
                                width={32}
                                height={32}
                                style="border-radius: 100%;"
                            />
                            <h2 style="color: var(--text-primary)">guoba.gg</h2>
                        </div>
                        <p class="sidebar-text">
                            Ver. -- - Bêta Build (GI Ver. --)
                        </p>
                    </div>
                    <div class="sidebar-search">
                        <div class="search-container">
                            <input
                                type="text"
                                id="uidInput"
                                class="search-input"
                                data-i18n-placeholder="ui.search.placeholder"
                            />
                            <button
                                id="searchBtn"
                                onclick="fetchUserData()"
                                class="search-btn"
                                ><img
                                    src="assets/simulator/icons/icon_search_white.svg"
                                    alt=""
                                    style="width: 20px; height: 20px;"
                                /></button
                            >
                        </div>
                    </div>
                    <div id="roadmap-sidebar-area" style="display: none;">
                        <button
                            id="roadmapSidebarBtn"
                            class="roadmap-sidebar-btn"
                            onclick="showAccountRoadmap()"
                        >
                            <div class="roadmap-btn-left">
                                <span class="roadmap-btn-icon">
                                    <svg
                                        width="26"
                                        height="26"
                                        viewBox="0 0 26 26"
                                        fill="none"
                                        xmlns="http://www.w3.org/2000/svg"
